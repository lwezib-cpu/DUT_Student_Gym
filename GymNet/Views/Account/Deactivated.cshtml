@{
    ViewBag.Title = "Account Deactivated";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="py-5" style="margin-top: 80px;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-5 text-center">
                        <div class="mb-4">
                            <i class="bi bi-person-x-fill text-danger" style="font-size: 64px;"></i>
                        </div>
                        <h2 class="fw-bold mb-3">Account Deactivated</h2>
                        <p class="text-muted mb-4">
                            Your account has been deactivated by the gym administrator.
                            If you believe this is a mistake, please contact us for assistance.
                        </p>
                        <div class="alert alert-info text-start" role="alert">
                            <i class="bi bi-info-circle me-2"></i>
                            <strong>Need help?</strong><br>
                            @Html.Raw("Contact us at: <a href=\"mailto:gym@dut.ac.za\">gym@dut.ac.za</a><br>")
                            Phone: +27 31 373 2000
                        </div>
                        <a href="@Url.Action("Index", "Home")" class="btn btn-danger px-4">
                            <i class="bi bi-house me-1"></i>Back to Home
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>