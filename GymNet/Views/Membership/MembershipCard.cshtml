﻿@model GymNet.ViewModels.MembershipCardViewModel
@{
    ViewBag.Title = "Membership Card";
    ViewBag.Active = "MyMembership";
    Layout = "~/Views/Shared/_MemberLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4 gn-no-print">
    <h2 class="fw-bold mb-0">Membership Card</h2>
    <button type="button" class="btn btn-danger" onclick="window.print()">
        <i class="bi bi-printer me-1"></i>Print / Save as PDF
    </button>
</div>

<div class="d-flex justify-content-center">
    <div class="gn-membership-card">
        <div class="gn-card-top">
            <div>
                <div class="gn-card-brand">DUT<span>GYM</span></div>
                <div class="gn-card-sub">Member Card</div>
            </div>
            <div class="gn-card-emoji">&#127939;</div>
        </div>

        <div class="gn-card-body">
            <div class="gn-card-label">Member</div>
            <div class="gn-card-name">@Model.FullName</div>
            <div class="gn-card-email">@Model.Email</div>

            <div class="row mt-3">
                <div class="col-6">
                    <div class="gn-card-label">Plan</div>
                    <div class="gn-card-value">@Model.PlanName</div>
                </div>
                <div class="col-6">
                    <div class="gn-card-label">Member ID</div>
                    <div class="gn-card-value">@Model.MemberId</div>
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-6">
                    <div class="gn-card-label">Valid From</div>
                    <div class="gn-card-value">@Model.StartDate.ToString("dd MMM yyyy")</div>
                </div>
                <div class="col-6">
                    <div class="gn-card-label">Valid Until</div>
                    <div class="gn-card-value">@Model.EndDate.ToString("dd MMM yyyy")</div>
                </div>
            </div>
        </div>

        <div class="gn-card-bottom">
            Present this card, or your student email, at check-in.
        </div>
    </div>
</div>

<style>
    .gn-membership-card {
        width: 100%;
        max-width: 420px;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 12px 30px rgba(19,36,31,0.18);
        background: #fff;
        border: 1px solid var(--gn-border, #eee);
    }
    .gn-card-top {
        background: linear-gradient(135deg, var(--gn-teal, #0E8F6E), var(--gn-teal-deep, #0B7259));
        color: #fff;
        padding: 20px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .gn-card-brand { font-weight: 800; font-size: 1.3rem; }
    .gn-card-brand span { color: var(--gn-gold, #E2A63B); }
    .gn-card-sub { font-size: 0.8rem; opacity: 0.85; }
    .gn-card-emoji { font-size: 2rem; }
    .gn-card-body { padding: 24px; }
    .gn-card-label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.04em; color: #888; }
    .gn-card-name { font-size: 1.3rem; font-weight: 700; }
    .gn-card-email { color: #666; font-size: 0.85rem; }
    .gn-card-value { font-weight: 600; }
    .gn-card-bottom {
        padding: 12px 24px;
        background: #f8f9fa;
        font-size: 0.78rem;
        color: #888;
        text-align: center;
    }

    @@media print {
        .gn-no-print, .dashboard-sidebar, .dashboard-topbar { display: none !important; }
        .dashboard-content { margin: 0 !important; padding: 0 !important; }
        body { background: #fff !important; }
    }
</style>
