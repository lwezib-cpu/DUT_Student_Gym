@model GymNet.ViewModels.ReceiptViewModel
@{
    ViewBag.Title = $"Receipt - {Model.TransactionReference}";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <!-- Add html2pdf library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <style>
        /* Your existing styles */
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .receipt-container {
            max-width: 800px;
            margin: 50px auto;
            background: white;
            border-radius: 10px;
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
            padding: 40px;
        }

        .receipt-header {
            border-bottom: 3px solid #dc3545;
            padding-bottom: 20px;
            margin-bottom: 30px;
        }

        .receipt-title {
            color: #dc3545;
            font-weight: bold;
            letter-spacing: 2px;
        }

        .company-logo {
            width: 80px;
            height: 80px;
            background: #dc3545;
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 40px;
            font-weight: bold;
        }

        .receipt-details {
            margin-bottom: 30px;
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px solid #e9ecef;
        }

        .detail-label {
            color: #6c757d;
            font-weight: 500;
        }

        .detail-value {
            font-weight: 600;
            text-align: right;
        }

        .amount-display {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 8px;
            text-align: center;
            margin: 20px 0;
        }

        .amount-value {
            font-size: 36px;
            font-weight: bold;
            color: #28a745;
        }

        .barcode {
            font-family: 'Courier New', monospace;
            letter-spacing: 3px;
            text-align: center;
            padding: 20px;
        }

        .action-buttons {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 1000;
            display: flex;
            gap: 10px;
        }

        .back-button {
            position: fixed;
            top: 20px;
            left: 20px;
            z-index: 1000;
        }

        @@media print {
            .action-buttons, .back-button {
                display: none !important;
            }

            .receipt-container {
                box-shadow: none;
                margin: 0;
                padding: 20px;
            }

            body {
                background: white;
            }
        }
    </style>
</head>
<body>
    <!-- Action Buttons -->
    <button type="button" class="btn btn-secondary back-button" onclick="window.close()">
        <i class="bi bi-arrow-left me-1"></i>Back
    </button>

    <div class="action-buttons">
        <button type="button" class="btn btn-success" onclick="downloadPDF()">
            <i class="bi bi-download me-1"></i>Download PDF
        </button>
        <button type="button" class="btn btn-primary" onclick="window.print()">
            <i class="bi bi-printer me-1"></i>Print
        </button>
    </div>

    <div class="receipt-container" id="receiptContent">
        <!-- Your receipt content here (same as before) -->
        <!-- Receipt Header -->
        <div class="receipt-header">
            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <div class="company-logo me-3">DUT</div>
                    <div>
                        <h2 class="mb-0">DUT FITNESS CENTER</h2>
                        <p class="text-muted mb-0">134 Steve Biko Road Durban</p>
                        <p class="text-muted mb-0">Tel: @Model.GymPhone | Email: @Model.GymEmail</p>
                    </div>
                </div>
                <div class="text-end">
                    <h3 class="receipt-title mb-0">RECEIPT</h3>
                    <p class="text-muted mb-0">Date: @DateTime.Now.ToString("dd MMMM yyyy HH:mm")</p>
                </div>
            </div>
        </div>

        <!-- Receipt Details -->
        <div class="row mb-4">
            <div class="col-6">
                <h6 class="text-muted mb-3">BILLED TO</h6>
                <p class="mb-1"><strong>@Model.MemberName</strong></p>
                <p class="mb-1">@Model.MemberEmail</p>
            </div>
            <div class="col-6 text-end">
                <h6 class="text-muted mb-3">RECEIPT DETAILS</h6>
                <p class="mb-1"><strong>Receipt No:</strong> @Model.TransactionReference</p>
                <p class="mb-1"><strong>Payment Date:</strong> @Model.PaymentDate.ToString("dd MMMM yyyy")</p>
                <p class="mb-1"><strong>Payment Method:</strong> @Model.PaymentMethod</p>
            </div>
        </div>

        <!-- Amount Display -->
        <div class="amount-display">
            <p class="text-muted mb-2">TOTAL AMOUNT PAID</p>
            <p class="amount-value mb-0">R @Model.Amount.ToString("F2")</p>
            <p class="text-success mt-2 mb-0">
                <i class="bi bi-check-circle-fill me-1"></i>@Model.Status
            </p>
        </div>

        <!-- Subscription Details -->
        <h6 class="fw-bold mb-3">SUBSCRIPTION DETAILS</h6>
        <div class="receipt-details">
            <div class="detail-row">
                <span class="detail-label">Membership Plan</span>
                <span class="detail-value">@Model.MembershipPlanName</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Subscription Period</span>
                <span class="detail-value">
                    @Model.MembershipStartDate.ToString("dd MMM yyyy") - @Model.MembershipEndDate.ToString("dd MMM yyyy")
                </span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Duration</span>
                <span class="detail-value">@((Model.MembershipEndDate - Model.MembershipStartDate).Days) days</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Status</span>
                <span class="detail-value">
                    @if (Model.MembershipEndDate > DateTime.Now)
                    {
                        <span class="text-success">Active</span>
                    }
                    else
                    {
                        <span class="text-danger">Expired</span>
                    }
                </span>
            </div>
        </div>

        <!-- Payment Details -->
        <h6 class="fw-bold mb-3 mt-4">PAYMENT DETAILS</h6>
        <div class="receipt-details">
            <div class="detail-row">
                <span class="detail-label">Bank</span>
                <span class="detail-value">@Model.BankName</span>
            </div>
            @if (!string.IsNullOrEmpty(Model.CardHolderName))
            {
                <div class="detail-row">
                    <span class="detail-label">Card Holder</span>
                    <span class="detail-value">@Model.CardHolderName</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.MaskedCardNumber))
            {
                <div class="detail-row">
                    <span class="detail-label">Card Number</span>
                    <span class="detail-value">@Model.MaskedCardNumber</span>
                </div>
            }
        </div>

        <!-- Receipt Footer -->
        <div class="text-center mt-4">
            <div class="barcode">
                ||||||||||||||||||||||||||||||||||||||||||||||||||||||||||
                <br />
                @Model.TransactionReference
            </div>
            <p class="text-muted mb-0">Thank you for your payment!</p>
            <p class="text-muted">For any queries, please contact us at @Model.GymPhone</p>
            <hr>
            <p class="text-muted small mb-0">This is a computer-generated receipt and does not require a signature.</p>
            <p class="text-muted small">Generated on @DateTime.Now.ToString("dd MMM yyyy HH:mm:ss")</p>
        </div>
    </div>

    <script>
    function downloadPDF() {
        // Get the receipt content
        const element = document.getElementById('receiptContent');

        // Get transaction reference from a data attribute instead of Razor
        const transactionRef = '@Model.TransactionReference';

        // Configure PDF options
        const options = {
            margin: [10, 10, 10, 10],
            filename: 'Receipt_' + transactionRef + '.pdf',
            image: { type: 'jpeg', quality: 0.98 },
            html2canvas: {
                scale: 2,
                useCORS: true,
                letterRendering: true
            },
            jsPDF: {
                unit: 'mm',
                format: 'a4',
                orientation: 'portrait'
            }
        };

        // Check if html2pdf is loaded
        if (typeof html2pdf !== 'undefined') {
            html2pdf().set(options).from(element).save();
        } else {
            // Fallback to print dialog
            window.print();
        }
    }
    </script>
</body>
</html>