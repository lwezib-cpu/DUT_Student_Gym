@model GymNet.ViewModels.MemberMembershipViewModel
@{
    ViewBag.Title = "My Membership";
    ViewBag.Active = "MyMembership";
    Layout = "~/Views/Shared/_MemberLayout.cshtml";
}

<h2 class="fw-bold mb-1">My Membership</h2>
<p class="text-muted mb-4">View your current membership details and status.</p>

<div class="row g-4">
    <!-- Membership Details Card -->
    <div class="col-md-8">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-patch-check me-2 text-danger"></i>
                    Membership Details
                </h5>
                @if (Model.Status == "Active")
                {
                    <span class="badge bg-success">Active</span>
                }
                else if (Model.Status == "PendingPayment")
                {
                    <span class="badge bg-warning text-dark">Pending Payment</span>
                }
                else if (Model.Status == "Expired")
                {
                    <span class="badge bg-danger">Expired</span>
                }
                else
                {
                    <span class="badge bg-secondary">@Model.Status</span>
                }
            </div>
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="membership-plan-icon bg-danger bg-opacity-10 text-danger rounded-3 p-4 text-center mb-3">
                            <i class="bi bi-award" style="font-size: 48px;"></i>
                        </div>
                        <h4 class="fw-bold mb-1">@Model.PlanName</h4>
                        <p class="text-muted mb-3">@Model.PlanDescription</p>

                        <div class="d-flex align-items-center mb-2">
                            <span class="text-muted me-2">Price:</span>
                            <strong>R@(Model.Price.ToString("F2"))</strong>
                        </div>
                        <div class="d-flex align-items-center mb-2">
                            <span class="text-muted me-2">Duration:</span>
                            <strong>@Model.DurationInMonths month(s)</strong>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <h6 class="fw-bold mb-3">Subscription Period</h6>

                        <div class="mb-3">
                            <small class="text-muted d-block">Start Date</small>
                            <strong>@Model.StartDate.ToString("dd MMM yyyy")</strong>
                        </div>

                        <div class="mb-3">
                            <small class="text-muted d-block">End Date</small>
                            <strong>@Model.EndDate.ToString("dd MMM yyyy")</strong>
                        </div>

                        <div class="mb-3">
                            <small class="text-muted d-block">Days Remaining</small>
                            @if (Model.DaysRemaining > 0)
                            {
                                <strong class="@(Model.DaysRemaining <= 7 ? "text-danger" : "text-success")">
                                    @Model.DaysRemaining days
                                </strong>
                            }
                            else
                            {
                                <strong class="text-danger">Expired</strong>
                            }
                        </div>

                        <div class="progress mb-3" style="height: 10px;">
                            @{
                                var totalDays = (Model.EndDate - Model.StartDate).Days;
                                var elapsedDays = (DateTime.Now - Model.StartDate).Days;
                                var progressPercentage = totalDays > 0 ? (int)((double)elapsedDays / totalDays * 100) : 0;
                                var progressColor = Model.DaysRemaining > 30 ? "bg-success" :
                                                   Model.DaysRemaining > 7 ? "bg-warning" : "bg-danger";
                            }
                            <div class="progress-bar @progressColor" role="progressbar"
                                 style="width: @progressPercentage%"
                                 aria-valuenow="@progressPercentage" aria-valuemin="0" aria-valuemax="100">
                            </div>
                        </div>
                        <small class="text-muted">@elapsedDays of @totalDays days used</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Payment Information -->
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-credit-card me-2 text-danger"></i>
                    Payment Information
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-md-3">
                        <div class="text-center p-3 bg-light rounded-3">
                            <small class="text-muted d-block mb-1">Payment Status</small>
                            @if (Model.PaymentStatus == "Completed")
                            {
                                <span class="badge bg-success">Paid</span>
                            }
                            else if (Model.PaymentStatus == "Pending")
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">No Payment</span>
                            }
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-center p-3 bg-light rounded-3">
                            <small class="text-muted d-block mb-1">Total Paid</small>
                            <strong class="fs-5">R@(Model.TotalPaid.ToString("F2"))</strong>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-center p-3 bg-light rounded-3">
                            <small class="text-muted d-block mb-1">Last Payment</small>
                            @if (Model.LastPaymentDate.HasValue)
                            {
                                <strong>@Model.LastPaymentDate.Value.ToString("dd MMM yyyy")</strong>
                            }
                            else
                            {
                                <strong class="text-muted">N/A</strong>
                            }
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-center p-3 bg-light rounded-3">
                            <small class="text-muted d-block mb-1">Payment Method</small>
                            <strong>@Model.PaymentMethod</strong>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.TransactionReference) && Model.TransactionReference != "N/A")
                {
                    <div class="mt-4">
                        <small class="text-muted d-block mb-1">Transaction Reference</small>
                        <code>@Model.TransactionReference</code>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Sidebar -->
    <div class="col-md-4">
        <!-- Status Card -->
        <div class="card shadow-sm mb-4">
            <div class="card-body text-center p-4">
                @if (Model.Status == "Active")
                {
                    <div class="mb-3">
                        <i class="bi bi-check-circle-fill text-success" style="font-size: 48px;"></i>
                    </div>
                    <h5 class="fw-bold text-success mb-2">Membership Active</h5>
                    <p class="text-muted mb-3">Your gym access is active. Enjoy your workouts!</p>
                }
                else if (Model.Status == "PendingPayment")
                {
                    <div class="mb-3">
                        <i class="bi bi-clock-fill text-warning" style="font-size: 48px;"></i>
                    </div>
                    <h5 class="fw-bold text-warning mb-2">Payment Pending</h5>
                    <p class="text-muted mb-3">Please contact the gym administrator to complete your payment.</p>
                }
                else if (Model.Status == "Expired")
                {
                    <div class="mb-3">
                        <i class="bi bi-x-circle-fill text-danger" style="font-size: 48px;"></i>
                    </div>
                    <h5 class="fw-bold text-danger mb-2">Membership Expired</h5>
                    <p class="text-muted mb-3">Your membership has expired. Renew to continue your access.</p>
                }

                @if (Model.Status != "Active")
                {
                    <a href="@Url.Action("Plans", "Membership")" class="btn btn-danger w-100">
                        <i class="bi bi-arrow-repeat me-1"></i>Renew Membership
                    </a>
                }
            </div>
        </div>

        <!-- Quick Links -->
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0 fw-bold">Quick Links</h5>
            </div>
            <div class="card-body p-3">
                <ul class="list-unstyled mb-0">
                    <li class="mb-2">
                        <a href="@Url.Action("Index", "CheckIn")" class="text-decoration-none">
                            <i class="bi bi-qr-code-scan me-2 text-danger"></i>
                            Check In to Gym
                        </a>
                    </li>
                    <li class="mb-2">
                        <a href="@Url.Action("History", "CheckIn")" class="text-decoration-none">
                            <i class="bi bi-calendar-check me-2 text-danger"></i>
                            Check-In History
                        </a>
                    </li>
                    <li class="mb-2">
                        <a href="@Url.Action("PaymentHistory", "Membership")" class="text-decoration-none">
                            <i class="bi bi-receipt me-2 text-danger"></i>
                            Payment History
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Plans", "Membership")" class="text-decoration-none">
                            <i class="bi bi-grid me-2 text-danger"></i>
                            View All Plans
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Help Card -->
        <div class="card shadow-sm mt-4">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3">
                    <i class="bi bi-question-circle me-2 text-danger"></i>
                    Need Help?
                </h6>
                <p class="text-muted small mb-3">
                    If you have questions about your membership or payment, contact the gym administrator.
                </p>
                <div class="small">
                    <p class="mb-1"><i class="bi bi-envelope me-2"></i>gym@dut.ac.za</p>
                    <p class="mb-0"><i class="bi bi-telephone me-2"></i>+27 31 373 2000</p>
                </div>
            </div>
        </div>
    </div>
</div>