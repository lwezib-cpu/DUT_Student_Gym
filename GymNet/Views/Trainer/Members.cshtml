﻿@model List<GymNet.ViewModels.TrainerMemberListItemViewModel>
@{
    ViewBag.Title = "My Members";
    ViewBag.Active = "Members";
    Layout = "~/Views/Shared/_TrainerLayout.cshtml";
}

<h2 class="fw-bold mb-1">My Members</h2>
<p class="text-muted mb-4">Members who have booked into one of your classes.</p>

@if (!Model.Any())
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <p class="text-muted mb-0">No members yet. Once someone joins one of your classes, they'll show up here.</p>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Member</th>
                        <th>Email</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model)
                    {
                        <tr>
                            <td><strong>@m.FullName</strong></td>
                            <td>@m.Email</td>
                            <td>
                                <a href="@Url.Action("GiveFeedback", "Trainer", new { memberId = m.UserId })" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-chat-square-text me-1"></i>Give Feedback
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
