﻿@using GymNet.Helpers
@model GymNet.ViewModels.TrainerDashboardViewModel
@{
    ViewBag.Title = "Trainer Dashboard";
    ViewBag.Active = "Dashboard";
    Layout = "~/Views/Shared/_TrainerLayout.cshtml";
}

<h2 class="fw-bold mb-1">Welcome, @User.Identity.GetFirstName()</h2>
<p class="text-muted mb-4">Your classes and members at a glance.</p>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card stat-card shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-muted mb-1">Upcoming Classes</h6>
                <h4 class="fw-bold mb-0">@Model.UpcomingClasses.Count</h4>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-muted mb-1">Members Coached</h6>
                <h4 class="fw-bold mb-0">@Model.TotalMembersCoached</h4>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-muted mb-1">Feedback Given</h6>
                <h4 class="fw-bold mb-0">@Model.TotalFeedbackGiven</h4>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="fw-bold mb-0">Upcoming Classes</h5>
    <a href="@Url.Action("CreateClass", "Trainer")" class="btn btn-danger btn-sm">
        <i class="bi bi-plus-circle me-1"></i>Create Class
    </a>
</div>

@if (!Model.UpcomingClasses.Any())
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <p class="text-muted mb-0">No upcoming classes. Create one to get started.</p>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm mb-4">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Title</th>
                        <th>Start</th>
                        <th>Duration</th>
                        <th>Booked</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.UpcomingClasses)
                    {
                        <tr>
                            <td>
                                <strong>@c.Title</strong>
                                @if (!string.IsNullOrEmpty(c.Description))
                                {
                                    <br /><small class="text-muted">@c.Description</small>
                                }
                            </td>
                            <td>@c.StartTime.ToString("dd MMM yyyy HH:mm")</td>
                            <td>@c.DurationMinutes min</td>
                            <td>
                                @c.BookedCount / @c.Capacity
                                @if (c.IsFull)
                                {
                                    <span class="badge bg-danger ms-1">Full</span>
                                }
                            </td>
                            <td>
                                @using (Html.BeginForm("CancelClass", "Trainer", new { id = c.Id }, FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Cancel this class?');">
                                        Cancel
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (Model.PastClasses.Any())
{
    <h5 class="fw-bold mb-3">Recent Past Classes</h5>
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Title</th>
                        <th>Date</th>
                        <th>Attended</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.PastClasses)
                    {
                        <tr>
                            <td>@c.Title</td>
                            <td>@c.StartTime.ToString("dd MMM yyyy HH:mm")</td>
                            <td>@c.BookedCount / @c.Capacity</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
