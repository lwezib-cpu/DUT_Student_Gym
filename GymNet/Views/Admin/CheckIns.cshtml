@model GymNet.ViewModels.AdminCheckInViewModel
@{
    ViewBag.Title = "Check-Ins";
    ViewBag.Active = "CheckIns";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="fw-bold mb-1">Check-In Records</h2>
<p class="text-muted mb-4">View member check-in history.</p>

<!-- Summary Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card stat-card shadow-sm">
            <div class="card-body">
                <div class="stat-icon bg-danger bg-opacity-10 text-danger mb-3">
                    <i class="bi bi-calendar-check"></i>
                </div>
                <h6 class="text-muted mb-1">Today's Check-Ins</h6>
                <h4 class="fw-bold mb-0">@Model.TotalCheckInsToday</h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card shadow-sm">
            <div class="card-body">
                <div class="stat-icon bg-primary bg-opacity-10 text-primary mb-3">
                    <i class="bi bi-people"></i>
                </div>
                <h6 class="text-muted mb-1">Unique Members Today</h6>
                <h4 class="fw-bold mb-0">@Model.UniqueMembersToday</h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card shadow-sm">
            <div class="card-body">
                <div class="stat-icon bg-success bg-opacity-10 text-success mb-3">
                    <i class="bi bi-clock-history"></i>
                </div>
                <h6 class="text-muted mb-1">All-Time Check-Ins</h6>
                <h4 class="fw-bold mb-0">@Model.TotalCheckInsAllTime</h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card shadow-sm">
            <div class="card-body">
                <div class="stat-icon bg-warning bg-opacity-10 text-warning mb-3">
                    <i class="bi bi-qr-code"></i>
                </div>
                <h6 class="text-muted mb-1">QR Code</h6>
                <a href="@Url.Action("GenerateQRCode", "Admin")" class="btn btn-sm btn-danger">
                    Generate QR
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card stat-card shadow-sm border-success">
            <div class="card-body">
                <div class="stat-icon bg-success bg-opacity-10 text-success mb-3">
                    <i class="bi bi-person-walking"></i>
                </div>
                <h6 class="text-muted mb-1">Currently In Gym</h6>
                <h4 class="fw-bold mb-0">@Model.MembersCurrentlyInGym</h4>
            </div>
        </div>
    </div>
</div>

<!-- Today's Check-Ins -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-white">
        <h5 class="mb-0 fw-bold">
            <i class="bi bi-calendar-check me-2 text-danger"></i>
            Today's Check-Ins
        </h5>
    </div>
    <div class="card-body p-0">
        @if (Model.TodayCheckIns.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Member</th>
                            <th>Time</th>
                            <th>Method</th>
                            <th>QR Code</th>
                            <th>Check-Out</th>
                            <th>Duration</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var checkIn in Model.TodayCheckIns)
                        {
                            <tr>
                                <td>
                                    <strong>@checkIn.FullName</strong>
                                    <br />
                                    <small class="text-muted">@checkIn.Email</small>
                                </td>
                                <td>@checkIn.CheckInTime.ToString("HH:mm:ss")</td>
                                <td>@checkIn.CheckInMethod</td>
                                <td><small class="text-muted">@checkIn.QRCode</small></td>
                                <td>
                                    @if (checkIn.CheckOutTime.HasValue)
                                    {
                                        @checkIn.CheckOutTime.Value.ToString("HH:mm:ss")
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">In gym</span>
                                    }
                                </td>
                                <td>
                                    @if (checkIn.DurationMinutes.HasValue)
                                    {
                                        @(checkIn.DurationMinutes.Value / 60)<text>h </text>@(checkIn.DurationMinutes.Value % 60)<text>m</text>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (!checkIn.CheckOutTime.HasValue)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="checkOutVisit(@checkIn.Id, this)">
                                            Check Out
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-center text-muted py-4 mb-0">No check-ins today yet.</p>
        }
    </div>
</div>

<!-- Recent Check-Ins -->
<div class="card shadow-sm">
    <div class="card-header bg-white">
        <h5 class="mb-0 fw-bold">
            <i class="bi bi-clock-history me-2 text-danger"></i>
            Recent Check-Ins
        </h5>
    </div>
    <div class="card-body p-0">
        @if (Model.AllCheckIns.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Member</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Method</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var checkIn in Model.AllCheckIns)
                        {
                            <tr>
                                <td>
                                    <strong>@checkIn.FullName</strong>
                                    <br />
                                    <small class="text-muted">@checkIn.Email</small>
                                </td>
                                <td>@checkIn.CheckInTime.ToString("dd MMM yyyy")</td>
                                <td>@checkIn.CheckInTime.ToString("HH:mm:ss")</td>
                                <td>@checkIn.CheckInMethod</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-center text-muted py-4 mb-0">No check-ins found.</p>
        }
    </div>
</div>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
}

<script>
    function checkOutVisit(checkInId, btn) {
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        btn.disabled = true;
        fetch('@Url.Action("CheckOutById", "Admin")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({ checkInId: checkInId, __RequestVerificationToken: token })
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                window.location.reload();
            } else {
                alert(data.message);
                btn.disabled = false;
            }
        })
        .catch(() => { btn.disabled = false; });
    }
</script>
