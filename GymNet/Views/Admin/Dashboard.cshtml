@model GymNet.ViewModels.AdminDashboardViewModel
@{
    ViewBag.Title = "Admin Dashboard";
    ViewBag.Active = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="fw-bold mb-1">Welcome, @Model.AdminName</h2>
<p class="text-muted mb-4">Here's an overview of GymNet.</p>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card stat-card shadow-sm">
            <div class="card-body d-flex align-items-center">
                <div class="stat-icon bg-danger bg-opacity-10 text-danger me-3">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1">Total Members</h6>
                    <h3 class="fw-bold mb-0">@Model.TotalMembers</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card shadow-sm">
            <div class="card-body d-flex align-items-center">
                <div class="stat-icon bg-primary bg-opacity-10 text-primary me-3">
                    <i class="bi bi-card-checklist"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1">Total Membership Plans</h6>
                    <h3 class="fw-bold mb-0">@Model.TotalMembershipPlans</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card shadow-sm">
            <div class="card-body d-flex align-items-center">
                <div class="stat-icon bg-success bg-opacity-10 text-success me-3">
                    <i class="bi bi-credit-card-fill"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1">Total Payments</h6>
                    <h3 class="fw-bold mb-0">@Model.TotalPayments</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="alert alert-secondary mt-4">
    <i class="bi bi-info-circle me-2"></i>
    "Total Members" is a live count from the database. Membership Plans and Payments
    totals are placeholders until those modules are built.
</div>