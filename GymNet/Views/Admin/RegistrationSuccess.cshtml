@{
    ViewBag.Title = "Registration Successful";
    ViewBag.Active = "Members";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-5 text-center">
                <div class="mb-4">
                    <i class="bi bi-check-circle-fill text-success" style="font-size: 64px;"></i>
                </div>
                <h2 class="fw-bold mb-3">Member Registered Successfully!</h2>
                <p class="text-muted mb-4">@ViewBag.SuccessMessage</p>

                <div class="alert alert-warning text-start" role="alert">
                    <h5 class="alert-heading fw-bold">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        Temporary Password Details
                    </h5>
                    <hr>
                    <p class="mb-2">
                        <strong>Email:</strong> @ViewBag.NewMemberEmail
                    </p>
                    <p class="mb-0">
                        <strong>Temporary Password:</strong>
                        <span class="badge bg-danger fs-6">@ViewBag.TempPassword</span>
                    </p>
                    <hr>
                    <p class="mb-0 small">
                        <i class="bi bi-info-circle me-1"></i>
                        Please share this temporary password with the member.
                        They will be able to log in and should change their password after first login.
                    </p>
                </div>

                <div class="d-flex justify-content-center gap-2">
                    <a href="@Url.Action("RegisterMember", "Admin")" class="btn btn-danger">
                        <i class="bi bi-person-plus me-1"></i>Register Another Member
                    </a>
                    <a href="@Url.Action("Members", "Admin")" class="btn btn-outline-primary">
                        <i class="bi bi-people me-1"></i>View All Members
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>