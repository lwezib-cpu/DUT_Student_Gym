@model List<GymNet.ViewModels.ManualCheckInMemberViewModel>
@{
    ViewBag.Title = "Manual Check-In";
    ViewBag.Active = "CheckIns";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="fw-bold mb-1">Manual Check-In</h2>
<p class="text-muted mb-4">Check in members manually if they can't scan the QR code.</p>

<!-- Summary Bar -->
<div class="alert alert-info mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <i class="bi bi-info-circle me-2"></i>
            <strong>Today's Check-Ins: @ViewBag.TodayCheckInCount</strong>
        </div>
        <a href="@Url.Action("CheckIns", "Admin")" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-eye me-1"></i>View All Check-Ins
        </a>
    </div>
</div>

<!-- Search -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        @using (Html.BeginForm("ManualCheckIn", "Admin", FormMethod.Get))
        {
            <div class="row g-3">
                <div class="col-md-8">
                    <label class="form-label">Search Member</label>
                    <input type="text" name="searchTerm" class="form-control"
                           placeholder="Search by name, email, or phone number..."
                           value="@ViewBag.SearchTerm" />
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button type="submit" class="btn btn-danger w-100">
                        <i class="bi bi-search me-1"></i>Search
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<!-- Members List -->
<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Member</th>
                        <th>Contact</th>
                        <th>Membership</th>
                        <th>Payment</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var member in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle bg-danger bg-opacity-10 text-danger me-2">
                                            @member.FullName.Substring(0, 1).ToUpper()
                                        </div>
                                        <div>
                                            <strong>@member.FullName</strong>
                                            <br />
                                            <small class="text-muted">@member.Email</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <i class="bi bi-telephone me-1"></i>@member.PhoneNumber
                                </td>
                                <td>
                                    <span class="d-block">@member.MembershipPlan</span>
                                    @if (member.MembershipStatus == "Active")
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else if (member.MembershipStatus == "Expired")
                                    {
                                        <span class="badge bg-warning text-dark">Expired</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@member.MembershipStatus</span>
                                    }
                                </td>
                                <td>
                                    @if (member.HasPaid)
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle me-1"></i>Paid
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-exclamation-circle me-1"></i>Unpaid
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (member.CheckedInToday)
                                    {
                                        <span class="badge bg-info">
                                            <i class="bi bi-check2-circle me-1"></i>Checked In
                                        </span>
                                    }
                                    else if (member.HasActiveMembership && member.HasPaid)
                                    {
                                        <span class="badge bg-light text-dark">
                                            <i class="bi bi-circle me-1"></i>Not Checked In
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            <i class="bi bi-x-circle me-1"></i>Ineligible
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-2">
                                        @if (!member.CheckedInToday && member.HasActiveMembership && member.HasPaid)
                                        {
                                            <button type="button" class="btn btn-sm btn-success checkin-btn"
                                                    data-user-id="@member.UserId"
                                                    data-member-name="@member.FullName">
                                                <i class="bi bi-person-check me-1"></i>Check In
                                            </button>
                                        }
                                        else if (member.IsCurrentlyCheckedIn)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger checkout-btn"
                                                    data-user-id="@member.UserId"
                                                    data-member-name="@member.FullName">
                                                <i class="bi bi-box-arrow-right me-1"></i>Check Out
                                            </button>
                                        }
                                        else if (member.CheckedInToday)
                                        {
                                            <button type="button" class="btn btn-sm btn-secondary" disabled>
                                                <i class="bi bi-check2-all me-1"></i>Already Checked In
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger" disabled
                                                    title="Member is not eligible to check in">
                                                <i class="bi bi-x-circle me-1"></i>Not Eligible
                                            </button>
                                        }

                                        <a href="@Url.Action("MemberCheckInHistory", "Admin", new { id = member.UserId })"
                                           class="btn btn-sm btn-outline-primary" title="View Check-In History">
                                            <i class="bi bi-clock-history"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <i class="bi bi-people fs-1 text-muted d-block mb-3"></i>
                                <h5>No members found</h5>
                                <p class="text-muted">Try adjusting your search criteria.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Confirmation Modal -->
<div class="modal fade" id="checkInModal" tabindex="-1" aria-labelledby="checkInModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="checkInModalLabel">
                    <i class="bi bi-person-check me-2 text-success"></i>
                    Confirm Check-In
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to check in <strong id="memberName"></strong>?</p>
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>
                    This will record the current time as the check-in time.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="confirmCheckInBtn">
                    <i class="bi bi-check2-circle me-1"></i>Confirm Check-In
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Result Modal -->
<div class="modal fade" id="resultModal" tabindex="-1" aria-labelledby="resultModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="resultModalLabel">Result</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="resultMessage">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        let selectedUserId = '';
        let selectedMemberName = '';

        $(document).ready(function() {
            // Handle check-in button click
            $('.checkin-btn').click(function() {
                selectedUserId = $(this).data('user-id');
                selectedMemberName = $(this).data('member-name');

                $('#memberName').text(selectedMemberName);
                $('#checkInModal').modal('show');
            });

            // Handle confirm check-in
            $('#confirmCheckInBtn').click(function() {
                if (selectedUserId) {
                    processManualCheckIn(selectedUserId);
                }
            });

            // Handle check-out button click
            $('.checkout-btn').click(function() {
                var userId = $(this).data('user-id');
                var memberName = $(this).data('member-name');
                if (confirm('Check out ' + memberName + '?')) {
                    processManualCheckOut(userId);
                }
            });
        });

        function processManualCheckOut(userId) {
            var token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("ProcessManualCheckOut", "Admin")',
                type: 'POST',
                data: {
                    userId: userId,
                    __RequestVerificationToken: token
                },
                success: function(response) {
                    $('#resultMessage').html('');

                    if (response.success) {
                        $('#resultMessage').html(
                            '<div class="alert alert-success">' +
                            '<i class="bi bi-check-circle me-2"></i>' +
                            response.message +
                            '</div>'
                        );
                    } else {
                        $('#resultMessage').html(
                            '<div class="alert alert-danger">' +
                            '<i class="bi bi-x-circle me-2"></i>' +
                            response.message +
                            '</div>'
                        );
                    }

                    $('#resultModal').modal('show');

                    setTimeout(function() {
                        window.location.reload();
                    }, 2000);
                },
                error: function() {
                    $('#resultMessage').html(
                        '<div class="alert alert-danger">' +
                        '<i class="bi bi-x-circle me-2"></i>' +
                        'An error occurred. Please try again.' +
                        '</div>'
                    );
                    $('#resultModal').modal('show');
                }
            });
        }

        function processManualCheckIn(userId) {
            // Hide confirmation modal
            $('#checkInModal').modal('hide');

            // Get anti-forgery token
            var token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("ProcessManualCheckIn", "Admin")',
                type: 'POST',
                data: {
                    userId: userId,
                    __RequestVerificationToken: token
                },
                success: function(response) {
                    $('#resultMessage').html('');

                    if (response.success) {
                        $('#resultMessage').html(
                            '<div class="alert alert-success">' +
                            '<i class="bi bi-check-circle me-2"></i>' +
                            response.message +
                            '</div>'
                        );
                    } else {
                        $('#resultMessage').html(
                            '<div class="alert alert-danger">' +
                            '<i class="bi bi-x-circle me-2"></i>' +
                            response.message +
                            '</div>'
                        );
                    }

                    $('#resultModal').modal('show');

                    // Reload page after 2 seconds
                    setTimeout(function() {
                        window.location.reload();
                    }, 2000);
                },
                error: function() {
                    $('#resultMessage').html(
                        '<div class="alert alert-danger">' +
                        '<i class="bi bi-x-circle me-2"></i>' +
                        'An error occurred. Please try again.' +
                        '</div>'
                    );
                    $('#resultModal').modal('show');
                }
            });
        }
    </script>
}