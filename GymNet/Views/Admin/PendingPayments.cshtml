@model List<GymNet.ViewModels.AdminPaymentListViewModel>
@{
    ViewBag.Title = "Pending Payments";
    ViewBag.Active = "Payments";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="fw-bold mb-1">Pending Payments</h2>
<p class="text-muted mb-4">Members who need to complete their payments.</p>

@if (Model.Any())
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Member</th>
                            <th>Plan</th>
                            <th>Amount Due</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var payment in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@payment.MemberName</strong>
                                    <br />
                                    <small class="text-muted">@payment.Email</small>
                                </td>
                                <td>@payment.PlanName</td>
                                <td class="fw-bold">R@(payment.Amount.ToString("F2"))</td>
                                <td>
                                    @if (payment.Status == "Completed")
                                    {
                                        <span class="badge bg-success">Paid</span>
                                    }
                                    else if (payment.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">@payment.Status</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <form method="post" action="@Url.Action("MarkAsPaid", "Admin", new { membershipId = payment.PaymentId })"
                                              onsubmit="return confirm('Mark this payment as completed?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-success">
                                                <i class="bi bi-check-circle me-1"></i>Mark as Paid
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-check-circle fs-1 text-success d-block mb-3"></i>
            <h4>No Pending Payments</h4>
            <p class="text-muted">All members have completed their payments.</p>
        </div>
    </div>
}