@model List<GymNet.ViewModels.CheckInHistoryViewModel>
@{
    ViewBag.Title = "Member Check-In History";
    ViewBag.Active = "CheckIns";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<a href="@Url.Action("ManualCheckIn", "Admin")" class="btn btn-outline-secondary mb-3">
    <i class="bi bi-arrow-left me-1"></i>Back to Manual Check-In
</a>

<h2 class="fw-bold mb-1">Check-In History</h2>
<p class="text-muted mb-4">
    For: <strong>@ViewBag.MemberName</strong> (@ViewBag.MemberEmail)
</p>

@if (Model.Any())
{
    <!-- Summary -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card stat-card shadow-sm">
                <div class="card-body">
                    <div class="stat-icon bg-primary bg-opacity-10 text-primary mb-3">
                        <i class="bi bi-calendar-check"></i>
                    </div>
                    <h6 class="text-muted mb-1">Total Check-Ins</h6>
                    <h4 class="fw-bold mb-0">@Model.Count</h4>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card stat-card shadow-sm">
                <div class="card-body">
                    <div class="stat-icon bg-success bg-opacity-10 text-success mb-3">
                        <i class="bi bi-calendar-week"></i>
                    </div>
                    <h6 class="text-muted mb-1">This Month</h6>
                    <h4 class="fw-bold mb-0">
                        @{
                            var thisMonth = DateTime.Now.Month;
                            var thisYear = DateTime.Now.Year;
                            var monthlyCount = Model.Count(c => c.CheckInTime.Month == thisMonth && c.CheckInTime.Year == thisYear);
                        }
                        @monthlyCount
                    </h4>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card stat-card shadow-sm">
                <div class="card-body">
                    <div class="stat-icon bg-danger bg-opacity-10 text-danger mb-3">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <h6 class="text-muted mb-1">Last Check-In</h6>
                    <h4 class="fw-bold mb-0">@Model.First().CheckInTime.ToString("dd MMM yyyy")</h4>
                    <p class="text-muted small mb-0">@Model.First().CheckInTime.ToString("HH:mm:ss")</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Check-In Table -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Day</th>
                            <th>Method</th>
                            <th>Reference</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var index = 1;
                        }
                        @foreach (var checkIn in Model)
                        {
                            <tr>
                                <td>@index</td>
                                <td>@checkIn.CheckInTime.ToString("dd MMM yyyy")</td>
                                <td>@checkIn.CheckInTime.ToString("HH:mm:ss")</td>
                                <td>@checkIn.CheckInTime.ToString("dddd")</td>
                                <td>
                                    @if (checkIn.CheckInMethod == "QR Code")
                                    {
                                        <span class="badge bg-primary">
                                            <i class="bi bi-qr-code-scan me-1"></i>QR Code
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-person-check me-1"></i>Manual
                                        </span>
                                    }
                                </td>
                                <td><small class="text-muted">@checkIn.QRCode</small></td>
                            </tr>
                            index++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-calendar-x fs-1 text-muted d-block mb-3"></i>
            <h4>No Check-Ins Found</h4>
            <p class="text-muted">This member hasn't checked in yet.</p>
        </div>
    </div>
}