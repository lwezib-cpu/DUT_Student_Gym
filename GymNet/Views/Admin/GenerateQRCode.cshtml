@model GymNet.ViewModels.GenerateQRCodeViewModel
@{
    ViewBag.Title = "Generate QR Code";
    ViewBag.Active = "CheckIns";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="fw-bold mb-1">Generate Check-In QR Code</h2>
<p class="text-muted mb-4">Display this QR code at the gym entrance for members to scan.</p>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body text-center p-4">
                <h5 class="fw-bold mb-3">QR Code</h5>

                <!-- QR Code Display -->
                <div class="qr-code-container mb-3" style="width: 300px; height: 300px; margin: 0 auto;">
                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=@Uri.EscapeDataString(Model.QRCodeContent)"
                         alt="Check-In QR Code" class="img-fluid" />
                </div>

                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>
                    QR Code is valid until: <strong>@Model.ValidUntil.ToString("dd MMM yyyy HH:mm")</strong>
                </div>

                <button class="btn btn-danger" onclick="window.print()">
                    <i class="bi bi-printer me-1"></i>Print QR Code
                </button>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3">Details</h5>

                <div class="mb-3">
                    <small class="text-muted d-block">QR Code Content</small>
                    <code>@Model.QRCodeContent</code>
                </div>

                <div class="mb-3">
                    <small class="text-muted d-block">Generated At</small>
                    <strong>@Model.GeneratedAt.ToString("dd MMM yyyy HH:mm:ss")</strong>
                </div>

                <div class="mb-3">
                    <small class="text-muted d-block">Valid Until</small>
                    <strong>@Model.ValidUntil.ToString("dd MMM yyyy HH:mm:ss")</strong>
                </div>

                <hr>

                <h6 class="fw-bold">Instructions:</h6>
                <ol class="small">
                    <li>Print this QR code or display it on a screen at the gym entrance.</li>
                    <li>Members will scan the QR code using the gym app.</li>
                    <li>The system will automatically verify their membership status.</li>
                    <li>Successful check-ins will be recorded in the system.</li>
                    <li>Generate a new QR code every 12 hours for security.</li>
                </ol>
            </div>
        </div>
    </div>
</div>