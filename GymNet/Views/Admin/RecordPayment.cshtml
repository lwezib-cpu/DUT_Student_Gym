@model GymNet.ViewModels.AdminRecordPaymentViewModel
@{
    ViewBag.Title = "Record Payment";
    ViewBag.Active = "Payments";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<a href="@Url.Action("PendingPayments", "Admin")" class="btn btn-outline-secondary mb-3">
    <i class="bi bi-arrow-left me-1"></i>Back to Pending Payments
</a>

<h2 class="fw-bold mb-1">Record Payment</h2>
<p class="text-muted mb-4">Record a manual payment for a member.</p>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="fw-bold mb-3">Member Details</h5>
                <p class="mb-2"><strong>@ViewBag.MemberName</strong></p>
                <p class="mb-2 text-muted">Plan: @ViewBag.PlanName</p>
                <p class="mb-2 text-muted">Status: @ViewBag.MembershipStatus</p>
                @if (ViewBag.MembershipEndDate != null)
                {
                    <p class="mb-0 text-muted">End Date: @ViewBag.MembershipEndDate</p>
                }
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                @using (Html.BeginForm("RecordPayment", "Admin", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.UserId)
                    @Html.HiddenFor(m => m.MemberMembershipId)
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                    <div class="row g-3">
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.Amount, new { @class = "form-label" })
                            <div class="input-group">
                                <span class="input-group-text">R</span>
                                @Html.TextBoxFor(m => m.Amount, new { @class = "form-control", type = "number", step = "0.01" })
                            </div>
                            @Html.ValidationMessageFor(m => m.Amount, "", new { @class = "text-danger small" })
                        </div>

                        <div class="col-md-6">
                            @Html.LabelFor(m => m.PaymentMethod, new { @class = "form-label" })
                            @Html.DropDownListFor(m => m.PaymentMethod,
                                new SelectListItem[]
                                {
                                    new SelectListItem { Text = "Select method", Value = "" },
                                    new SelectListItem { Text = "Cash", Value = "Cash" },
                                    new SelectListItem { Text = "Card", Value = "Card" },
                                    new SelectListItem { Text = "EFT", Value = "EFT" },
                                    new SelectListItem { Text = "Manual", Value = "Manual" }
                                }, new { @class = "form-select" })
                            @Html.ValidationMessageFor(m => m.PaymentMethod, "", new { @class = "text-danger small" })
                        </div>

                        <div class="col-12">
                            @Html.LabelFor(m => m.TransactionReference, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.TransactionReference, new { @class = "form-control", placeholder = "Optional - leave blank for auto-generated" })
                            @Html.ValidationMessageFor(m => m.TransactionReference, "", new { @class = "text-danger small" })
                        </div>

                        <div class="col-12">
                            @Html.LabelFor(m => m.Notes, new { @class = "form-label" })
                            @Html.TextAreaFor(m => m.Notes, new { @class = "form-control", rows = "3", placeholder = "Optional notes" })
                        </div>

                        <div class="col-12 mt-4">
                            <button type="submit" class="btn btn-success px-4">
                                <i class="bi bi-check-circle me-1"></i>Record Payment & Activate Membership
                            </button>
                            <a href="@Url.Action("PendingPayments", "Admin")" class="btn btn-outline-secondary">
                                Cancel
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}