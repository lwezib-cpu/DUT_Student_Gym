﻿@model GymNet.ViewModels.AnalyticsViewModel
@{
    ViewBag.Title = "Analytics";
    ViewBag.Active = "Analytics";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="fw-bold mb-1">Analytics</h2>
<p class="text-muted mb-4">Revenue, membership, and activity trends across GymNet.</p>

<div class="row g-4 mb-4">
    <div class="col-md-4 col-lg-2">
        <div class="card stat-card shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-muted mb-1 small">Total Revenue</h6>
                <h4 class="fw-bold mb-0">R@(Model.TotalRevenueAllTime.ToString("N0"))</h4>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="card stat-card shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-muted mb-1 small">Revenue This Month</h6>
                <h4 class="fw-bold mb-0">R@(Model.RevenueThisMonth.ToString("N0"))</h4>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="card stat-card shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-muted mb-1 small">Active Members</h6>
                <h4 class="fw-bold mb-0">@Model.ActiveMembersCount <span class="text-muted small">/ @Model.TotalMembersCount</span></h4>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="card stat-card shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-muted mb-1 small">Check-Ins This Month</h6>
                <h4 class="fw-bold mb-0">@Model.CheckInsThisMonth</h4>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="card stat-card shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-muted mb-1 small">Avg. Class Fill Rate</h6>
                <h4 class="fw-bold mb-0">@Model.AverageClassFillRatePercent%</h4>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="card shadow-sm h-100">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3">Revenue - Last 6 Months</h5>
                <canvas id="revenueChart" height="90"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3">Membership Status</h5>
                <canvas id="statusChart" height="220"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-12">
        <div class="card shadow-sm h-100">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3">Check-Ins - Last 14 Days</h5>
                <canvas id="checkinsChart" height="70"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3">Most-Booked Classes</h5>
                @if (!Model.TopClasses.Any())
                {
                    <p class="text-muted mb-0">No class bookings yet.</p>
                }
                else
                {
                    <canvas id="classesChart" height="180"></canvas>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3">Most-Reserved Equipment</h5>
                @if (!Model.TopEquipment.Any())
                {
                    <p class="text-muted mb-0">No equipment reservations yet.</p>
                }
                else
                {
                    <canvas id="equipmentChart" height="180"></canvas>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        var teal = '#0E8F6E';
        var gold = '#E2A63B';
        var berry = '#9C3357';
        var ink = '#13241F';

        // Revenue - line chart
        new Chart(document.getElementById('revenueChart'), {
            type: 'line',
            data: {
                labels: @Html.Raw(Json.Encode(Model.RevenueByMonth.Select(p => p.Label))),
                datasets: [{
                    label: 'Revenue (R)',
                    data: @Html.Raw(Json.Encode(Model.RevenueByMonth.Select(p => p.Value))),
                    borderColor: teal,
                    backgroundColor: 'rgba(14, 143, 110, 0.12)',
                    fill: true,
                    tension: 0.3
                }]
            },
            options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
        });

        // Membership status - doughnut
        new Chart(document.getElementById('statusChart'), {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(Json.Encode(Model.MembershipStatusBreakdown.Select(p => p.Label))),
                datasets: [{
                    data: @Html.Raw(Json.Encode(Model.MembershipStatusBreakdown.Select(p => p.Value))),
                    backgroundColor: [teal, berry, gold, '#9CA3AF']
                }]
            },
            options: { plugins: { legend: { position: 'bottom' } } }
        });

        // Check-ins - bar chart
        new Chart(document.getElementById('checkinsChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Encode(Model.CheckInsByDay.Select(p => p.Label))),
                datasets: [{
                    label: 'Check-ins',
                    data: @Html.Raw(Json.Encode(Model.CheckInsByDay.Select(p => p.Value))),
                    backgroundColor: teal
                }]
            },
            options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
        });

        @if (Model.TopClasses.Any())
        {
            <text>
        new Chart(document.getElementById('classesChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Encode(Model.TopClasses.Select(c => c.Name))),
                datasets: [{
                    label: 'Bookings',
                    data: @Html.Raw(Json.Encode(Model.TopClasses.Select(c => c.Count))),
                    backgroundColor: gold
                }]
            },
            options: { indexAxis: 'y', plugins: { legend: { display: false } }, scales: { x: { beginAtZero: true, ticks: { precision: 0 } } } }
        });
            </text>
        }

        @if (Model.TopEquipment.Any())
        {
            <text>
        new Chart(document.getElementById('equipmentChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Encode(Model.TopEquipment.Select(e => e.Name))),
                datasets: [{
                    label: 'Reservations',
                    data: @Html.Raw(Json.Encode(Model.TopEquipment.Select(e => e.Count))),
                    backgroundColor: ink
                }]
            },
            options: { indexAxis: 'y', plugins: { legend: { display: false } }, scales: { x: { beginAtZero: true, ticks: { precision: 0 } } } }
        });
            </text>
        }
    </script>
}
