﻿@model List<GymNet.ViewModels.EquipmentBookingAdminListItemViewModel>
@{
    ViewBag.Title = "Equipment Bookings";
    ViewBag.Active = "EquipmentBookings";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="fw-bold mb-1">Equipment Bookings</h2>
<p class="text-muted mb-4">Approve or decline new requests, and confirm equipment once it's returned.</p>

@{
    var pending = Model.Where(b => b.Status == "PendingApproval").ToList();
    var active = Model.Where(b => b.Status == "Reserved").ToList();
    var history = Model.Where(b => b.Status == "Returned" || b.Status == "Declined" || b.Status == "Cancelled").ToList();
}

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card stat-card shadow-sm h-100 border-warning">
            <div class="card-body">
                <h6 class="text-muted mb-1">Awaiting Approval</h6>
                <h4 class="fw-bold mb-0">@pending.Count</h4>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-muted mb-1">Currently Out</h6>
                <h4 class="fw-bold mb-0">@active.Count</h4>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-muted mb-1">Completed / Declined</h6>
                <h4 class="fw-bold mb-0">@history.Count</h4>
            </div>
        </div>
    </div>
</div>

<h5 class="fw-bold mb-3">Equipment</h5>
<div class="card shadow-sm mb-4">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Equipment</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var eq in (List<GymNet.Models.Equipment>)ViewBag.EquipmentList)
                {
                    <tr>
                        <td><strong>@eq.Name</strong></td>
                        <td>
                            @if (eq.IsUnderMaintenance)
                            {
                                <span class="badge bg-warning text-dark">Under Maintenance</span>
                                if (!string.IsNullOrEmpty(eq.MaintenanceNote))
                                {
                                    <div class="text-muted small mt-1">@eq.MaintenanceNote</div>
                                }
                            }
                            else
                            {
                                <span class="badge bg-success">Available</span>
                            }
                        </td>
                        <td>
                            @using (Html.BeginForm("ToggleEquipmentMaintenance", "Admin", new { id = eq.Id }, FormMethod.Post, new { id = "maintForm" + eq.Id }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="note" id="maintNote@(eq.Id)" />
                                if (eq.IsUnderMaintenance)
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-success">Mark Available</button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-outline-dark" onclick="markMaintenance(@eq.Id)">Mark Under Maintenance</button>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<h5 class="fw-bold mb-3">Awaiting Approval</h5>
@if (!pending.Any())
{
    <p class="text-muted">No pending requests.</p>
}
else
{
    <div class="card shadow-sm mb-4">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Member</th>
                        <th>Equipment</th>
                        <th>Requested</th>
                        <th>Duration</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in pending)
                    {
                        <tr>
                            <td><strong>@b.MemberName</strong><br /><small class="text-muted">@b.MemberEmail</small></td>
                            <td>
                                <div class="d-flex align-items-center">
                                    @if (!string.IsNullOrEmpty(b.EquipmentImageUrl))
                                    {
                                        <img src="@Url.Content(b.EquipmentImageUrl)" alt="@b.EquipmentName" class="rounded me-2" style="width: 40px; height: 40px; object-fit: contain;" />
                                    }
                                    else
                                    {
                                        <i class="bi @b.EquipmentIconClass text-danger me-2" style="font-size: 1.5rem;"></i>
                                    }
                                    @b.EquipmentName
                                </div>
                            </td>
                            <td>@b.ReservedAt.ToString("dd MMM HH:mm")</td>
                            <td>@b.ExpectedDurationMinutes min</td>
                            <td>
                                @using (Html.BeginForm("ApproveEquipmentBooking", "Admin", new { id = b.Id }, FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger me-1">Approve</button>
                                }
                                @using (Html.BeginForm("DeclineEquipmentBooking", "Admin", new { id = b.Id }, FormMethod.Post, new { id = "declineForm" + b.Id }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="reason" id="declineReason@(b.Id)" />
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            onclick="declineWithReason(@b.Id)">Decline</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<h5 class="fw-bold mb-3">Currently Out</h5>
@if (!active.Any())
{
    <p class="text-muted">No equipment currently checked out.</p>
}
else
{
    <div class="card shadow-sm mb-4">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Member</th>
                        <th>Equipment</th>
                        <th>Approved</th>
                        <th>Expected Return</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in active)
                    {
                        var isOverdue = DateTime.Now > b.ExpectedReturnAt;
                        <tr>
                            <td><strong>@b.MemberName</strong><br /><small class="text-muted">@b.MemberEmail</small></td>
                            <td>
                                <div class="d-flex align-items-center">
                                    @if (!string.IsNullOrEmpty(b.EquipmentImageUrl))
                                    {
                                        <img src="@Url.Content(b.EquipmentImageUrl)" alt="@b.EquipmentName" class="rounded me-2" style="width: 40px; height: 40px; object-fit: contain;" />
                                    }
                                    else
                                    {
                                        <i class="bi @b.EquipmentIconClass text-danger me-2" style="font-size: 1.5rem;"></i>
                                    }
                                    @b.EquipmentName
                                </div>
                            </td>
                            <td>@b.ReservedAt.ToString("dd MMM HH:mm")</td>
                            <td>
                                @b.ExpectedReturnAt.ToString("dd MMM HH:mm")
                                @if (isOverdue)
                                {
                                    <span class="badge bg-danger ms-1">Overdue</span>
                                }
                            </td>
                            <td>
                                @using (Html.BeginForm("ConfirmEquipmentReturn", "Admin", new { id = b.Id }, FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger">Confirm Return</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<h5 class="fw-bold mb-3">History</h5>
@if (!history.Any())
{
    <p class="text-muted">Nothing completed yet.</p>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Member</th>
                        <th>Equipment</th>
                        <th>Reservation Fee</th>
                        <th>Overuse Fee</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in history)
                    {
                        <tr>
                            <td><strong>@b.MemberName</strong></td>
                            <td>
                                <div class="d-flex align-items-center">
                                    @if (!string.IsNullOrEmpty(b.EquipmentImageUrl))
                                    {
                                        <img src="@Url.Content(b.EquipmentImageUrl)" alt="@b.EquipmentName" class="rounded me-2" style="width: 32px; height: 32px; object-fit: contain;" />
                                    }
                                    else
                                    {
                                        <i class="bi @b.EquipmentIconClass text-danger me-2"></i>
                                    }
                                    @b.EquipmentName
                                </div>
                            </td>
                            <td>R@(b.ReservationFeeCharged.ToString("F2"))</td>
                            <td>@(b.OverageFeeCharged > 0 ? "R" + b.OverageFeeCharged.ToString("F2") : "-")</td>
                            <td>
                                @if (b.Status == "Returned")
                                {
                                    <span class="badge bg-secondary">Returned</span>
                                }
                                else if (b.Status == "Cancelled")
                                {
                                    <span class="badge bg-secondary">Cancelled by member</span>
                                }
                                else
                                {
                                    <span class="badge bg-dark">Declined</span>
                                    if (!string.IsNullOrEmpty(b.DeclineReason))
                                    {
                                        <div class="text-muted small mt-1">@b.DeclineReason</div>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section scripts {
    <script>
        function declineWithReason(bookingId) {
            var reason = prompt('Reason for declining this booking (shown to the member):');
            if (reason === null) return;
            document.getElementById('declineReason' + bookingId).value = reason;
            document.getElementById('declineForm' + bookingId).submit();
        }

        function markMaintenance(equipmentId) {
            var note = prompt('Optional note about the maintenance (shown to members):') || '';
            document.getElementById('maintNote' + equipmentId).value = note;
            document.getElementById('maintForm' + equipmentId).submit();
        }
    </script>
}
