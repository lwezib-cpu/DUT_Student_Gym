﻿@model List<GymNet.ViewModels.EquipmentBookingListItemViewModel>
@{
    ViewBag.Title = "My Equipment Bookings";
    ViewBag.Active = "Equipment";
    Layout = "~/Views/Shared/_MemberLayout.cshtml";
}

<h2 class="fw-bold mb-1">My Equipment Bookings</h2>
<p class="text-muted mb-4">New requests need admin approval before they're confirmed. Return equipment on time to avoid overuse fees.</p>

@if (!Model.Any())
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <p class="text-muted mb-0">No bookings yet.</p>
            <a href="@Url.Action("Index", "Equipment")" class="btn btn-danger mt-2">Browse Equipment</a>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Equipment</th>
                        <th>Reserved At</th>
                        <th>Expected Return</th>
                        <th>Actual Return</th>
                        <th>Reservation Fee</th>
                        <th>Overuse Fee</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model)
                    {
                        <tr>
                            <td><strong>@b.EquipmentName</strong></td>
                            <td>@b.ReservedAt.ToString("dd MMM HH:mm")</td>
                            <td>@b.ExpectedReturnAt.ToString("dd MMM HH:mm")</td>
                            <td>
                                @if (b.ActualReturnAt.HasValue)
                                {
                                    @b.ActualReturnAt.Value.ToString("dd MMM HH:mm")
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Still out</span>
                                }
                            </td>
                            <td>R@(b.ReservationFeeCharged.ToString("F2"))</td>
                            <td>
                                @if (b.OverageFeeCharged > 0)
                                {
                                    <span class="text-danger">R@(b.OverageFeeCharged.ToString("F2"))</span>
                                }
                                else
                                {
                                    <span class="text-muted">R0.00</span>
                                }
                            </td>
                            <td>
                                @if (b.Status == "PendingApproval")
                                {
                                    <span class="badge bg-warning text-dark">Awaiting Approval</span>
                                    <br />
                                    using (Html.BeginForm("CancelBooking", "Equipment", new { id = b.Id }, FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger mt-1"
                                                onclick="return confirm('Cancel this booking request?');">
                                            Cancel Request
                                        </button>
                                    }
                                }
                                else if (b.Status == "Declined")
                                {
                                    <span class="badge bg-dark">Declined</span>
                                    if (!string.IsNullOrEmpty(b.DeclineReason))
                                    {
                                        <div class="text-muted small mt-1">@b.DeclineReason</div>
                                    }
                                }
                                else if (b.Status == "Cancelled")
                                {
                                    <span class="badge bg-secondary">Cancelled by you</span>
                                }
                                else if (b.Status == "Reserved")
                                {
                                    <span class="badge bg-success">Approved - awaiting return check-in</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Returned</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
