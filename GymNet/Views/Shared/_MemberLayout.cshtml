@using Microsoft.AspNet.Identity
@using GymNet.Helpers
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - GymNet</title>
    @Styles.Render("~/Content/css")
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>
<body class="dashboard-body">

    <!-- ============ TOP BAR ============ -->
    <nav class="navbar navbar-dark bg-dark dashboard-topbar fixed-top">
        <div class="container-fluid">
            <button class="btn btn-outline-light d-lg-none" type="button"
                    data-bs-toggle="offcanvas" data-bs-target="#memberSidebar">
                <i class="bi bi-list"></i> Menu
            </button>
            <a class="navbar-brand fw-bold ms-2" href="@Url.Action("Dashboard", "Member")">
                DUT<span class="text-danger">GYM</span>
            </a>
            <div class="d-flex align-items-center">
                <button class="btn btn-sm btn-outline-light theme-toggle-btn me-3" type="button" title="Toggle light/dark mode">
                    <i class="theme-toggle-icon bi bi-moon-stars-fill"></i>
                </button>
                <span class="text-light me-3 d-none d-md-inline">Hi, @User.Identity.GetFirstName()</span>
                @using (Html.BeginForm("Logout", "Account", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-light">
                        <i class="bi bi-box-arrow-right me-1"></i>Logout
                    </button>
                }
            </div>
        </div>
    </nav>

    <!-- ============ SIDEBAR ============ -->
    <div class="offcanvas-lg offcanvas-start bg-dark dashboard-sidebar" tabindex="-1" id="memberSidebar">
        <div class="offcanvas-header d-lg-none">
            <h5 class="text-light mb-0">Menu</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#memberSidebar"></button>
        </div>
        <div class="offcanvas-body p-0">
            <ul class="nav flex-column dashboard-nav">
                <li class="nav-item">
                    <a class="nav-link @(ViewBag.Active == "Dashboard" ? "active" : "")" href="@Url.Action("Dashboard", "Member")">
                        <i class="bi bi-speedometer2 me-2"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewBag.Active == "CheckIn" ? "active" : "")" href="@Url.Action("Index", "CheckIn")">
                        <i class="bi bi-qr-code-scan me-2"></i> Check In / Out
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewBag.Active == "CheckInHistory" ? "active" : "")" href="@Url.Action("History", "CheckIn")">
                        <i class="bi bi-calendar-check me-2"></i> Check-In History
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewBag.Active == "Fitness" ? "active" : "")" href="@Url.Action("Index", "Fitness")">
                        <i class="bi bi-clipboard2-pulse me-2"></i> Fitness Goals
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewBag.Active == "MealBuilder" ? "active" : "")" href="@Url.Action("MealBuilder", "Fitness")">
                        <i class="bi bi-basket2 me-2"></i> Build a Meal
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewBag.Active == "Exercises" ? "active" : "")" href="@Url.Action("Index", "Exercise")">
                        <i class="bi bi-person-arms-up me-2"></i> Exercises
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewBag.Active == "Classes" ? "active" : "")" href="@Url.Action("Index", "Class")">
                        <i class="bi bi-people me-2"></i> Classes
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewBag.Active == "Equipment" ? "active" : "")" href="@Url.Action("Index", "Equipment")">
                        <i class="bi bi-bicycle me-2"></i> Equipment Booking
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewBag.Active == "Feedback" ? "active" : "")" href="@Url.Action("Feedback", "Member")">
                        <i class="bi bi-chat-square-text me-2"></i> Trainer Feedback
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewBag.Active == "Plans" ? "active" : "")" href="@Url.Action("Plans", "Membership")">
                        <i class="bi bi-grid-fill me-2"></i> Membership Plans
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewBag.Active == "MyMembership" ? "active" : "")" href="@Url.Action("MyMembership", "Membership")">
                        <i class="bi bi-patch-check me-2"></i> My Membership
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewBag.Active == "Payments" ? "active" : "")" href="@Url.Action("PaymentHistory", "Membership")">
                        <i class="bi bi-credit-card me-2"></i> Payment History
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "Home")" target="_blank">
                        <i class="bi bi-house me-2"></i> Back to Site
                    </a>
                </li>
            </ul>
        </div>
    </div>

    <!-- ============ MAIN CONTENT ============ -->
    <main class="dashboard-content">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </main>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Html.Raw("<script src=\"https://cdn.jsdelivr.net/npm/@lottiefiles/lottie-player@2.0.8/dist/lottie-player.js\"></script>")
    <script src="~/Scripts/theme-toggle.js"></script>
    @RenderSection("scripts", required: false)

<!-- ============ FAQ CHAT BOT ============ -->
<button type="button" id="gnChatToggle" class="gn-chat-toggle" title="Chat with GymNet Assistant">
    <span class="gn-robot">
        <span class="gn-robot-antenna"></span>
        <span class="gn-robot-head">
            <span class="gn-robot-eye"></span>
            <span class="gn-robot-eye"></span>
            <span class="gn-robot-mouth"></span>
        </span>
    </span>
</button>
<div id="gnChatPanel" class="gn-chat-panel">
    <div class="gn-chat-header">
        <span>🤖 GymNet Assistant</span>
        <div>
            <button type="button" id="gnChatVoiceToggle" title="Turn voice answers on/off">
                <svg id="gnVoiceIcon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M4 9v6h4l5 5V4L8 9H4z"/>
                    <path d="M16.5 12a4.5 4.5 0 0 0-2.5-4.03v8.06A4.5 4.5 0 0 0 16.5 12z"/>
                    <path d="M14 4.55v2.06a7 7 0 0 1 0 10.78v2.06A9 9 0 0 0 14 4.55z"/>
                </svg>
            </button>
            <button type="button" id="gnChatClose" title="Close">&times;</button>
        </div>
    </div>
    <div id="gnChatLog" class="gn-chat-log"></div>
    <div class="gn-chat-input-row">
        <button type="button" id="gnChatMic" title="Speak your question">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 15a3 3 0 0 0 3-3V6a3 3 0 0 0-6 0v6a3 3 0 0 0 3 3z"/>
                <path d="M19 11a1 1 0 0 0-2 0 5 5 0 0 1-10 0 1 1 0 0 0-2 0 7 7 0 0 0 6 6.92V20H9a1 1 0 0 0 0 2h6a1 1 0 0 0 0-2h-2v-2.08A7 7 0 0 0 19 11z"/>
            </svg>
        </button>
        <input type="text" id="gnChatInput" placeholder="Ask a question..." />
        <button type="button" id="gnChatSend" title="Send">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M2 12l19-9-5 9 5 9-19-9zm4.5 0l9.5 4.3L12.5 12 16 7.7 6.5 12z"/>
            </svg>
        </button>
    </div>
</div>
<script src="~/Scripts/chatbot.js"></script>
</body>
</html>