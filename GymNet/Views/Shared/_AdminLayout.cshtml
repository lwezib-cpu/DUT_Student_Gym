@using Microsoft.AspNet.Identity
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - GymNet Admin</title>
    @Styles.Render("~/Content/css")
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>
<body class="dashboard-body">

    <!-- ============ TOP BAR ============ -->
    <nav class="navbar navbar-dark bg-dark dashboard-topbar fixed-top">
        <div class="container-fluid">
            <button class="btn btn-outline-light d-lg-none" type="button"
                    data-bs-toggle="offcanvas" data-bs-target="#adminSidebar">
                <i class="bi bi-list"></i> Menu
            </button>
            <a class="navbar-brand fw-bold ms-2" href="@Url.Action("Dashboard", "Admin")">
                GYM<span class="text-danger">NET</span> <span class="fw-normal">Admin</span>
            </a>
            <div class="d-flex align-items-center">
                <span class="text-light me-3 d-none d-md-inline">Hi, @User.Identity.GetUserName()</span>
                @using (Html.BeginForm("Logout", "Account", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-light">
                        <i class="bi bi-box-arrow-right me-1"></i>Logout
                    </button>
                }
            </div>
        </div>
    </nav>

    <!-- ============ SIDEBAR ============ -->
    <div class="offcanvas-lg offcanvas-start bg-dark dashboard-sidebar" tabindex="-1" id="adminSidebar">
        <div class="offcanvas-header d-lg-none">
            <h5 class="text-light mb-0">Menu</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#adminSidebar"></button>
        </div>
        <div class="offcanvas-body p-0">
            <ul class="nav flex-column dashboard-nav">
                <li class="nav-item">
                    <a class="nav-link @(ViewBag.Active == "Dashboard" ? "active" : "")" href="@Url.Action("Dashboard", "Admin")">
                        <i class="bi bi-speedometer2 me-2"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewBag.Active == "RegisterMember" ? "active" : "")" href="@Url.Action("RegisterMember", "Admin")">
                        <i class="bi bi-person-plus me-2"></i> Register Member
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewBag.Active == "Members" ? "active" : "")" href="@Url.Action("Members", "Admin")">
                        <i class="bi bi-people me-2"></i> Members
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(ViewBag.Active == "CheckIns" ? "active" : "")" href="@Url.Action("CheckIns", "Admin")">
                        <i class="bi bi-calendar-check me-2"></i> Check-Ins
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewBag.Active == "ManualCheckIn" ? "active" : "")" href="@Url.Action("ManualCheckIn", "Admin")">
                        <i class="bi bi-person-check me-2"></i> Manual Check-In
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewBag.Active == "Payments" ? "active" : "")" href="@Url.Action("PendingPayments", "Admin")">
                        <i class="bi bi-clock-history me-2"></i> Pending Payments
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewBag.Active == "AllPayments" ? "active" : "")" href="@Url.Action("AllPayments", "Admin")">
                        <i class="bi bi-receipt me-2"></i> All Payments
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "Home")" target="_blank">
                        <i class="bi bi-house me-2"></i> Back to Site
                    </a>
                </li>
            </ul>
        </div>
    </div>

    <!-- ============ MAIN CONTENT ============ -->
    <main class="dashboard-content">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </main>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

    <!-- Add this line to render the scripts section -->
    @RenderSection("scripts", required: false)
</body>
</html>