﻿@using Microsoft.AspNet.Identity
@using GymNet.Helpers
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - GymNet Trainer</title>
    @Styles.Render("~/Content/css")
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>
<body class="dashboard-body">

    <!-- ============ TOP BAR ============ -->
    <nav class="navbar navbar-dark bg-dark dashboard-topbar fixed-top">
        <div class="container-fluid">
            <button class="btn btn-outline-light d-lg-none" type="button"
                    data-bs-toggle="offcanvas" data-bs-target="#trainerSidebar">
                <i class="bi bi-list"></i> Menu
            </button>
            <a class="navbar-brand fw-bold ms-2" href="@Url.Action("Dashboard", "Trainer")">
                DUT<span class="text-danger">GYM</span> <span class="badge bg-danger ms-1">Trainer</span>
            </a>
            <div class="d-flex align-items-center">
                <button class="btn btn-sm btn-outline-light theme-toggle-btn me-3" type="button" title="Toggle light/dark mode">
                    <i class="theme-toggle-icon bi bi-moon-stars-fill"></i>
                </button>
                <span class="text-light me-3 d-none d-md-inline">Hi, @User.Identity.GetFirstName()</span>
                @using (Html.BeginForm("Logout", "Account", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-light">
                        <i class="bi bi-box-arrow-right me-1"></i>Logout
                    </button>
                }
            </div>
        </div>
    </nav>

    <!-- ============ SIDEBAR ============ -->
    <div class="offcanvas-lg offcanvas-start bg-dark dashboard-sidebar" tabindex="-1" id="trainerSidebar">
        <div class="offcanvas-header d-lg-none">
            <h5 class="text-light mb-0">Menu</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#trainerSidebar"></button>
        </div>
        <div class="offcanvas-body p-0">
            <ul class="nav flex-column dashboard-nav">
                <li class="nav-item">
                    <a class="nav-link @(ViewBag.Active == "Dashboard" ? "active" : "")" href="@Url.Action("Dashboard", "Trainer")">
                        <i class="bi bi-speedometer2 me-2"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewBag.Active == "CreateClass" ? "active" : "")" href="@Url.Action("CreateClass", "Trainer")">
                        <i class="bi bi-plus-circle me-2"></i> Create Class
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewBag.Active == "Members" ? "active" : "")" href="@Url.Action("Members", "Trainer")">
                        <i class="bi bi-people me-2"></i> My Members
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "Home")" target="_blank">
                        <i class="bi bi-house me-2"></i> Back to Site
                    </a>
                </li>
            </ul>
        </div>
    </div>

    <!-- ============ MAIN CONTENT ============ -->
    <main class="dashboard-content">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </main>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    <script src="~/Scripts/theme-toggle.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
