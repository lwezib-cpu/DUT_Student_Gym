<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - DUTGYM</title>
    @Styles.Render("~/Content/css")
    @RenderSection("styles", required: false)
</head>
<body>

    <!-- ============ NAVIGATION BAR ============ -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" href="@Url.Action("Index", "Home")">
                DUT<span class="text-danger">GYM</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav ms-auto align-items-lg-center">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Home")#hero">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Home")#about">About</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Home")#contact">Contact</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Plans", "Membership")">Memberships</a>
                    </li>
                    <li class="nav-item">
                        <!-- Placeholder: wired to real Account/Login in the Identity step -->
                        <a class="nav-link" href="/Account/Login">Login</a>
                    </li>
                    <li class="nav-item ms-lg-2 mt-2 mt-lg-0">
                        <!-- Placeholder: wired to real Account/Register in the Identity step -->
                        <a class="btn btn-danger" href="/Account/Register">Register</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- ============ PAGE CONTENT ============ -->
    <div>
        @RenderBody()
    </div>

    <!-- ============ FOOTER ============ -->
    <footer class="bg-dark text-light pt-5 pb-4">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-4">
                    <h4 class="fw-bold">DUT<span class="text-danger">GYM</span></h4>
                    <p class="text-secondary">
                        Your journey to a stronger, healthier you starts here.
                        Modern equipment, expert guidance, real results.
                    </p>
                </div>
                <div class="col-md-4 mb-4">
                    <h5>Quick Links</h5>
                    <ul class="list-unstyled">
                        <li><a href="@Url.Action("Index", "Home")#hero" class="text-secondary text-decoration-none">Home</a></li>
                        <li><a href="@Url.Action("Index", "Home")#about" class="text-secondary text-decoration-none">About</a></li>
                        <li><a href="@Url.Action("Index", "Home")#memberships" class="text-secondary text-decoration-none">Memberships</a></li>
                        <li><a href="@Url.Action("Index", "Home")#contact" class="text-secondary text-decoration-none">Contact</a></li>
                    </ul>
                </div>
                <div class="col-md-4 mb-4">
                    <h5>Contact Info</h5>
                    <ul class="list-unstyled text-secondary">
                        <li><i class="bi bi-geo-alt"></i> 123 Fitness Street, Your City</li>
                        <li><i class="bi bi-telephone"></i> +27 000 000 0000</li>
                        <li><i class="bi bi-envelope"></i> info@dutgym.com</li>
                    </ul>
                </div>
            </div>
            <hr class="border-secondary" />
            <p class="text-center text-secondary mb-0">
                &copy; @DateTime.Now.Year DUTGYM. All rights reserved.
            </p>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/site")
    <script src="~/Scripts/theme-toggle.js"></script>
    @RenderSection("scripts", required: false)

<!-- ============ FAQ CHAT BOT ============ -->
<button type="button" id="gnChatToggle" class="gn-chat-toggle" title="Chat with GymNet Assistant">
    <span class="gn-robot">
        <span class="gn-robot-antenna"></span>
        <span class="gn-robot-head">
            <span class="gn-robot-eye"></span>
            <span class="gn-robot-eye"></span>
            <span class="gn-robot-mouth"></span>
        </span>
    </span>
</button>
<div id="gnChatPanel" class="gn-chat-panel">
    <div class="gn-chat-header">
        <span>🤖 GymNet Assistant</span>
        <div>
            <button type="button" id="gnChatVoiceToggle" title="Turn voice answers on/off">
                <svg id="gnVoiceIcon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M4 9v6h4l5 5V4L8 9H4z"/>
                    <path d="M16.5 12a4.5 4.5 0 0 0-2.5-4.03v8.06A4.5 4.5 0 0 0 16.5 12z"/>
                    <path d="M14 4.55v2.06a7 7 0 0 1 0 10.78v2.06A9 9 0 0 0 14 4.55z"/>
                </svg>
            </button>
            <button type="button" id="gnChatClose" title="Close">&times;</button>
        </div>
    </div>
    <div id="gnChatLog" class="gn-chat-log"></div>
    <div class="gn-chat-input-row">
        <button type="button" id="gnChatMic" title="Speak your question">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 15a3 3 0 0 0 3-3V6a3 3 0 0 0-6 0v6a3 3 0 0 0 3 3z"/>
                <path d="M19 11a1 1 0 0 0-2 0 5 5 0 0 1-10 0 1 1 0 0 0-2 0 7 7 0 0 0 6 6.92V20H9a1 1 0 0 0 0 2h6a1 1 0 0 0 0-2h-2v-2.08A7 7 0 0 0 19 11z"/>
            </svg>
        </button>
        <input type="text" id="gnChatInput" placeholder="Ask a question..." />
        <button type="button" id="gnChatSend" title="Send">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M2 12l19-9-5 9 5 9-19-9zm4.5 0l9.5 4.3L12.5 12 16 7.7 6.5 12z"/>
            </svg>
        </button>
    </div>
</div>
<script src="~/Scripts/chatbot.js"></script>
</body>
</html>
