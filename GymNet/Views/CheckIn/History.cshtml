@model List<GymNet.ViewModels.CheckInHistoryViewModel>
@{
    ViewBag.Title = "Check-In History";
    ViewBag.Active = "CheckInHistory";
    Layout = "~/Views/Shared/_MemberLayout.cshtml";

    // Declared here (the file's top-level code block) rather than nested inside
    // @if (Model.Any()) { }, because a bare { } used deeper in the page is plain
    // C# block syntax and scopes "var" to just that block - the top-level @{ }
    // is a Razor transition marker instead, so anything declared here stays
    // visible to markup anywhere else in the file.
    var totalMinutesAllTime = Model.Where(c => c.DurationMinutes.HasValue).Sum(c => c.DurationMinutes.Value);
    var monthStart = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    var totalMinutesThisMonth = Model.Where(c => c.DurationMinutes.HasValue && c.CheckInTime >= monthStart).Sum(c => c.DurationMinutes.Value);
}

<h2 class="fw-bold mb-1">Check-In History</h2>
<p class="text-muted mb-4">Your gym attendance records.</p>

@{
    var calMonth = (int)ViewBag.CalendarMonth;
    var calYear = (int)ViewBag.CalendarYear;
    var checkedInDays = (List<int>)ViewBag.CheckedInDays;
    var firstOfMonth = new DateTime(calYear, calMonth, 1);
    var daysInMonth = DateTime.DaysInMonth(calYear, calMonth);
    var startWeekday = (int)firstOfMonth.DayOfWeek; // 0 = Sunday
    var prevMonth = calMonth == 1 ? 12 : calMonth - 1;
    var prevYear = calMonth == 1 ? calYear - 1 : calYear;
    var nextMonth = calMonth == 12 ? 1 : calMonth + 1;
    var nextYear = calMonth == 12 ? calYear + 1 : calYear;
    var today = DateTime.Today;
}

<div class="card shadow-sm mb-4">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <a href="@Url.Action("History", "CheckIn", new { month = prevMonth, year = prevYear })" class="btn btn-outline-secondary">
                <i class="bi bi-chevron-left"></i>
            </a>
            <h4 class="fw-bold mb-0">@firstOfMonth.ToString("MMMM yyyy")</h4>
            <a href="@Url.Action("History", "CheckIn", new { month = nextMonth, year = nextYear })" class="btn btn-outline-secondary">
                <i class="bi bi-chevron-right"></i>
            </a>
        </div>

        <div class="gn-calendar">
            <div class="gn-calendar-head">Sun</div>
            <div class="gn-calendar-head">Mon</div>
            <div class="gn-calendar-head">Tue</div>
            <div class="gn-calendar-head">Wed</div>
            <div class="gn-calendar-head">Thu</div>
            <div class="gn-calendar-head">Fri</div>
            <div class="gn-calendar-head">Sat</div>

            @for (var i = 0; i < startWeekday; i++)
            {
                <div class="gn-calendar-cell gn-calendar-empty"></div>
            }
            @for (var day = 1; day <= daysInMonth; day++)
            {
                var isCheckedIn = checkedInDays.Contains(day);
                var isToday = today.Year == calYear && today.Month == calMonth && today.Day == day;
                <div class="gn-calendar-cell @(isCheckedIn ? "gn-calendar-checkedin" : "") @(isToday ? "gn-calendar-today" : "")">
                    <span class="gn-calendar-daynum">@day</span>
                    @if (isCheckedIn)
                    {
                        <i class="bi bi-check-circle-fill gn-calendar-check"></i>
                    }
                </div>
            }
        </div>

        <div class="d-flex align-items-center gap-3 mt-3">
            <span class="small text-muted"><span class="gn-calendar-legend gn-calendar-checkedin"></span> Checked in</span>
            <span class="small text-muted"><span class="gn-calendar-legend gn-calendar-today"></span> Today</span>
        </div>
    </div>
</div>

<style>
    .gn-calendar {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 6px;
    }
    .gn-calendar-head {
        text-align: center;
        font-weight: 700;
        color: var(--gn-teal, #0E8F6E);
        padding-bottom: 6px;
        font-size: 0.9rem;
    }
    .gn-calendar-cell {
        aspect-ratio: 1 / 1;
        min-height: 44px;
        max-width: 60px;
        border-radius: 8px;
        border: 1px solid var(--gn-border, #eee);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        position: relative;
        font-size: 0.85rem;
        margin: 0 auto;
    }
    .gn-calendar-empty {
        border: none;
    }
    .gn-calendar-daynum {
        font-weight: 600;
    }
    .gn-calendar-checkedin {
        background-color: var(--gn-teal, #0E8F6E);
        color: #fff;
        border-color: var(--gn-teal, #0E8F6E);
    }
    .gn-calendar-check {
        font-size: 0.9rem;
        margin-top: 2px;
    }
    .gn-calendar-today:not(.gn-calendar-checkedin) {
        border: 2px solid var(--gn-gold, #E2A63B);
    }
    .gn-calendar-legend {
        display: inline-block;
        width: 14px;
        height: 14px;
        border-radius: 4px;
        vertical-align: middle;
        margin-right: 4px;
    }
    .gn-calendar-legend.gn-calendar-checkedin { background-color: var(--gn-teal, #0E8F6E); }
    .gn-calendar-legend.gn-calendar-today { border: 2px solid var(--gn-gold, #E2A63B); background: transparent; }
    @@media (max-width: 576px) {
        .gn-calendar-cell { min-height: 34px; font-size: 0.75rem; }
    }
</style>

@if (Model.Any())
{
    <!-- Summary Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card stat-card shadow-sm h-100">
                <div class="card-body">
                    <div class="stat-icon bg-primary bg-opacity-10 text-primary mb-3">
                        <i class="bi bi-calendar-check"></i>
                    </div>
                    <h6 class="text-muted mb-1">Total Check-Ins</h6>
                    <h4 class="fw-bold mb-0">@Model.Count</h4>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card stat-card shadow-sm h-100">
                <div class="card-body">
                    <div class="stat-icon bg-success bg-opacity-10 text-success mb-3">
                        <i class="bi bi-calendar-week"></i>
                    </div>
                    <h6 class="text-muted mb-1">This Month</h6>
                    <h4 class="fw-bold mb-0">
                        @{
                            var thisMonth = DateTime.Now.Month;
                            var thisYear = DateTime.Now.Year;
                            var monthlyCount = Model.Count(c => c.CheckInTime.Month == thisMonth && c.CheckInTime.Year == thisYear);
                        }
                        @monthlyCount
                    </h4>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card stat-card shadow-sm h-100">
                <div class="card-body">
                    <div class="stat-icon bg-danger bg-opacity-10 text-danger mb-3">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <h6 class="text-muted mb-1">Last Check-In</h6>
                    <h4 class="fw-bold mb-0">@Model.First().CheckInTime.ToString("dd MMM")</h4>
                    <p class="text-muted small mb-0">@Model.First().CheckInTime.ToString("HH:mm")</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Time Spent Summary -->
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card stat-card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted mb-1">Time Spent This Month</h6>
                    <h4 class="fw-bold mb-0">@(totalMinutesThisMonth / 60)h @(totalMinutesThisMonth % 60)m</h4>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card stat-card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted mb-1">Time Spent All Time</h6>
                    <h4 class="fw-bold mb-0">@(totalMinutesAllTime / 60)h @(totalMinutesAllTime % 60)m</h4>
                </div>
            </div>
        </div>
    </div>

    <!-- Check-In History Table -->
    <div class="card shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold">
                <i class="bi bi-qr-code-scan me-2 text-danger"></i>
                All Check-Ins
            </h5>
            <a href="@Url.Action("Index", "CheckIn")" class="btn btn-sm btn-danger">
                <i class="bi bi-qr-code-scan me-1"></i>Check In Now
            </a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Day</th>
                            <th>Method</th>
                            <th>QR Code</th>
                            <th>Check-Out</th>
                            <th>Duration</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var index = 1;
                        }
                        @foreach (var checkIn in Model)
                        {
                            <tr>
                                <td>@index</td>
                                <td>@checkIn.CheckInTime.ToString("dd MMM yyyy")</td>
                                <td>@checkIn.CheckInTime.ToString("HH:mm:ss")</td>
                                <td>@checkIn.CheckInTime.ToString("dddd")</td>
                                <td>
                                    @if (checkIn.CheckInMethod == "QR Code")
                                    {
                                        <span class="badge bg-primary">
                                            <i class="bi bi-qr-code-scan me-1"></i>QR Code
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@checkIn.CheckInMethod</span>
                                    }
                                </td>
                                <td><small class="text-muted">@checkIn.QRCode</small></td>
                                <td>
                                    @if (checkIn.CheckOutTime.HasValue)
                                    {
                                        @checkIn.CheckOutTime.Value.ToString("HH:mm:ss")
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Still in gym</span>
                                    }
                                </td>
                                <td>
                                    @if (checkIn.DurationMinutes.HasValue)
                                    {
                                        @(checkIn.DurationMinutes.Value / 60)<text>h </text>@(checkIn.DurationMinutes.Value % 60)<text>m</text>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            </tr>
                            index++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Weekly Summary -->
    <div class="card shadow-sm mt-4">
        <div class="card-header bg-white">
            <h5 class="mb-0 fw-bold">
                <i class="bi bi-graph-up me-2 text-danger"></i>
                Weekly Summary
            </h5>
        </div>
        <div class="card-body p-4">
            <div class="row g-3">
                @{
                    var days = new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" };
                    var startOfWeek = DateTime.Today.AddDays(-(int)DateTime.Today.DayOfWeek + 1);
                    if (DateTime.Today.DayOfWeek == DayOfWeek.Sunday)
                    {
                        startOfWeek = DateTime.Today.AddDays(-6);
                    }
                }
                @foreach (var day in days)
                {
                    var dayDate = startOfWeek.AddDays(Array.IndexOf(days, day));
                    var count = Model.Count(c => c.CheckInTime.Date == dayDate.Date);

                    <div class="col-md-1 col-3 text-center">
                        <div class="card @(count > 0 ? "border-danger" : "border-light") @(DateTime.Today.Date == dayDate.Date ? "bg-light" : "")">
                            <div class="card-body p-2">
                                <small class="d-block text-muted">@day.Substring(0, 3)</small>
                                <strong class="@(count > 0 ? "text-danger" : "text-muted")">@count</strong>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <p class="text-muted small mt-3 mb-0">
                <i class="bi bi-info-circle me-1"></i>
                Number of check-ins per day this week.
            </p>
        </div>
    </div>

    <div class="alert alert-info mt-4">
        <i class="bi bi-info-circle me-2"></i>
        Total check-ins: <strong>@Model.Count</strong>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-qr-code-scan fs-1 text-muted d-block mb-3"></i>
            <h4>No Check-Ins Yet</h4>
            <p class="text-muted mb-4">You haven't checked in to the gym yet.</p>
            <a href="@Url.Action("Index", "CheckIn")" class="btn btn-danger">
                <i class="bi bi-qr-code-scan me-1"></i>Go to Check-In
            </a>
        </div>
    </div>
}