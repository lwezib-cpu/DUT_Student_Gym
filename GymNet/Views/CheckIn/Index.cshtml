@model GymNet.ViewModels.CheckInViewModel
@{
    ViewBag.Title = "Check In";
    ViewBag.Active = "CheckIn";
    Layout = "~/Views/Shared/_MemberLayout.cshtml";
}

<h2 class="fw-bold mb-1">Gym Check-In</h2>
<p class="text-muted mb-4">Scan the QR code at the gym entrance to check in.</p>

<div class="row g-4">
    <!-- Status Card -->
    <div class="col-md-5">
        <div class="card shadow-sm h-100">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3">Your Status</h5>

                <div class="mb-3">
                    <small class="text-muted d-block">Member</small>
                    <strong>@Model.FullName</strong>
                </div>

                <div class="mb-3">
                    <small class="text-muted d-block">Membership Plan</small>
                    <strong>@Model.MembershipPlan</strong>
                </div>

                <div class="mb-3">
                    <small class="text-muted d-block">Membership Status</small>
                    @if (Model.MembershipStatus == "Active")
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">@Model.MembershipStatus</span>
                    }
                </div>

                @if (Model.MembershipEndDate.HasValue)
                {
                    <div class="mb-3">
                        <small class="text-muted d-block">Valid Until</small>
                        <strong>@Model.MembershipEndDate.Value.ToString("dd MMM yyyy")</strong>
                        @{
                            var daysLeft = (Model.MembershipEndDate.Value - DateTime.Now).Days;
                            if (daysLeft > 0)
                            {
                                <span class="badge bg-success ms-2">@daysLeft days left</span>
                            }
                            else
                            {
                                <span class="badge bg-danger ms-2">Expired</span>
                            }
                        }
                    </div>
                }

                <hr>

                @if (Model.IsCheckedInNow)
                {
                    <div class="alert alert-success">
                        <i class="bi bi-stopwatch me-2"></i>
                        You checked in at @Model.OpenCheckInTime.Value.ToString("HH:mm")
                    </div>
                    <div class="text-center mb-3">
                        <div class="text-muted small">Time in gym</div>
                        <div id="liveTimer" class="fw-bold" style="font-size: 2rem;" data-checkin="@Model.OpenCheckInTime.Value.ToString("o")">00:00:00</div>
                    </div>
                    <button type="button" class="btn btn-outline-danger w-100" onclick="checkOut()">
                        <i class="bi bi-box-arrow-right me-1"></i>Check Out
                    </button>
                    <div id="checkoutResult" class="mt-2"></div>
                }
                else if (Model.CanCheckIn)
                {
                    <div class="alert alert-success">
                        <i class="bi bi-check-circle me-2"></i>
                        @Model.Message
                    </div>
                }
                else
                {
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        @Model.Message
                    </div>

                    <a href="@Url.Action("Plans", "Membership")" class="btn btn-danger w-100">
                        <i class="bi bi-grid me-1"></i>View Membership Plans
                    </a>
                }

                <hr>
                <div class="row text-center">
                    <div class="col-6">
                        <small class="text-muted d-block">This Month</small>
                        <strong>@(Model.TotalMinutesThisMonth / 60)h @(Model.TotalMinutesThisMonth % 60)m</strong>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">All Time</small>
                        <strong>@(Model.TotalMinutesAllTime / 60)h @(Model.TotalMinutesAllTime % 60)m</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scanner Card -->
    <div class="col-md-7">
        <div class="card shadow-sm h-100">
            <div class="card-body p-4 text-center">
                @if (Model.IsCheckedInNow)
                {
                    <div class="d-flex flex-column align-items-center justify-content-center h-100">
                        <i class="bi bi-person-walking text-success" style="font-size: 80px;"></i>
                        <h5 class="text-muted mt-3">You're in the gym</h5>
                        <p class="text-muted">Use the Check Out button when you leave.</p>
                    </div>
                }
                else if (Model.CanCheckIn)
                {
                    <h5 class="fw-bold mb-3">Scan QR Code</h5>
                    <p class="text-muted mb-4">Point your camera at the QR code displayed at the gym entrance.</p>

                    <!-- QR Scanner -->
                    <div id="qr-reader" style="width: 100%; max-width: 500px; margin: 0 auto;"></div>

                    <!-- Manual Entry -->
                    <div class="mt-4">
                        <p class="text-muted mb-2">Or enter the QR code manually:</p>
                        <div class="input-group mb-3">
                            <input type="text" id="manualQRCode" class="form-control" placeholder="Enter QR code..." />
                            <button class="btn btn-danger" type="button" onclick="processManualQR()">
                                <i class="bi bi-check2-circle me-1"></i>Submit
                            </button>
                        </div>
                    </div>

                    <!-- Result Message -->
                    <div id="resultMessage" class="mt-3"></div>
                }
                else
                {
                    <div class="d-flex flex-column align-items-center justify-content-center h-100">
                        <i class="bi bi-qr-code-scan text-muted" style="font-size: 80px;"></i>
                        <h5 class="text-muted mt-3">Scanner Unavailable</h5>
                        <p class="text-muted">Please resolve your membership issues to access the scanner.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- QR Code Scanner Library -->
<script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>

<script>
    let html5QrCode;

    function onScanSuccess(decodedText, decodedResult) {
        // Stop scanning
        if (html5QrCode) {
            html5QrCode.stop().then(() => {
                console.log("QR Code scanning stopped.");
            }).catch((err) => {
                console.log("Error stopping scanner: ", err);
            });
        }

        // Process the QR code
        processQRCode(decodedText);
    }

    function onScanError(errorMessage) {
        // Ignore errors - they happen frequently during scanning
        console.log(errorMessage);
    }

    function startScanner() {
        html5QrCode = new Html5Qrcode("qr-reader");

        const config = {
            fps: 10,
            qrbox: { width: 250, height: 250 },
            aspectRatio: 1.0
        };

        html5QrCode.start(
            { facingMode: "environment" },
            config,
            onScanSuccess,
            onScanError
        ).catch((err) => {
            console.error("Error starting scanner: ", err);
            document.getElementById('resultMessage').innerHTML =
                '<div class="alert alert-danger">Failed to start camera. Please ensure camera permissions are granted.</div>';
        });
    }

    function processQRCode(qrContent) {
        fetch('@Url.Action("ProcessQRCode", "CheckIn")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': '@Html.AntiForgeryToken().ToString()'
            },
            body: new URLSearchParams({
                'qrCodeContent': qrContent,
                '__RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
            })
        })
        .then(response => response.json())
        .then(data => {
            const resultDiv = document.getElementById('resultMessage');
            if (data.Success) {
                resultDiv.innerHTML = '<div class="alert alert-success">' + data.Message + '</div>';
                setTimeout(() => {
                    window.location.reload();
                }, 2000);
            } else {
                resultDiv.innerHTML = '<div class="alert alert-danger">' + data.Message + '</div>';
                // Restart scanner after error
                setTimeout(() => {
                    startScanner();
                }, 3000);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            document.getElementById('resultMessage').innerHTML =
                '<div class="alert alert-danger">An error occurred. Please try again.</div>';
        });
    }

    function checkOut() {
        fetch('@Url.Action("CheckOut", "CheckIn")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': '@Html.AntiForgeryToken().ToString()'
            },
            body: new URLSearchParams({
                '__RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
            })
        })
        .then(response => response.json())
        .then(data => {
            const resultDiv = document.getElementById('checkoutResult');
            if (resultDiv) {
                resultDiv.innerHTML = '<div class="alert ' + (data.Success ? 'alert-success' : 'alert-danger') + '">' + data.Message + '</div>';
            }
            if (data.Success) {
                setTimeout(() => { window.location.reload(); }, 1500);
            }
        })
        .catch(error => {
            console.error('Error:', error);
        });
    }

    function startLiveTimer() {
        const el = document.getElementById('liveTimer');
        if (!el) return;
        const checkinTime = new Date(el.getAttribute('data-checkin'));

        function tick() {
            const diffMs = Math.max(0, new Date() - checkinTime);
            const totalSeconds = Math.floor(diffMs / 1000);
            const h = String(Math.floor(totalSeconds / 3600)).padStart(2, '0');
            const m = String(Math.floor((totalSeconds % 3600) / 60)).padStart(2, '0');
            const s = String(totalSeconds % 60).padStart(2, '0');
            el.textContent = h + ':' + m + ':' + s;
        }
        tick();
        setInterval(tick, 1000);
    }

    function processManualQR() {
        const qrContent = document.getElementById('manualQRCode').value.trim();
        if (qrContent) {
            processQRCode(qrContent);
        } else {
            alert('Please enter a QR code.');
        }
    }

    // Start scanner on page load
    document.addEventListener('DOMContentLoaded', function() {
        @if (Model.CanCheckIn && !Model.IsCheckedInNow)
        {
            <text>startScanner();</text>
        }
        startLiveTimer();
    });
</script>