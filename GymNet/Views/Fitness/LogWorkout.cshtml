﻿@model GymNet.ViewModels.LogWorkoutViewModel
@{
    ViewBag.Title = "Log Workout";
    ViewBag.Active = "Fitness";
    Layout = "~/Views/Shared/_MemberLayout.cshtml";
}

<h2 class="fw-bold mb-1">Log a Workout</h2>
<p class="text-muted mb-4">Record what you actually did - this builds your own training history over time.</p>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                @using (Html.BeginForm("LogWorkout", "Fitness", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                    <div class="mb-3">
                        @Html.LabelFor(m => m.ExerciseName, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.ExerciseName, new { @class = "form-control", placeholder = "e.g. Barbell Bench Press" })
                        @Html.ValidationMessageFor(m => m.ExerciseName, "", new { @class = "text-danger small" })
                    </div>

                    <div class="row">
                        <div class="col-4 mb-3">
                            @Html.LabelFor(m => m.Sets, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Sets, new { @class = "form-control", type = "number" })
                            @Html.ValidationMessageFor(m => m.Sets, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-4 mb-3">
                            @Html.LabelFor(m => m.Reps, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Reps, new { @class = "form-control", type = "number" })
                            @Html.ValidationMessageFor(m => m.Reps, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-4 mb-3">
                            @Html.LabelFor(m => m.WeightKg, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.WeightKg, new { @class = "form-control", type = "number", step = "0.5" })
                            @Html.ValidationMessageFor(m => m.WeightKg, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-danger py-2">Save Workout</button>
                        <a href="@Url.Action("WorkoutHistory", "Fitness")" class="btn btn-outline-secondary">View History</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
