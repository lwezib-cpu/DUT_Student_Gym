﻿@model GymNet.ViewModels.LogMeasurementViewModel
@{
    ViewBag.Title = "Log Measurement";
    ViewBag.Active = "Fitness";
    Layout = "~/Views/Shared/_MemberLayout.cshtml";
}

<h2 class="fw-bold mb-1">Log Measurement</h2>
<p class="text-muted mb-4">Record your current weight and height. We'll calculate your BMI automatically.</p>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                @using (Html.BeginForm("LogMeasurement", "Fitness", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                    <div class="mb-3">
                        @Html.LabelFor(m => m.WeightKg, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.WeightKg, new { @class = "form-control", type = "number", step = "0.1" })
                        @Html.ValidationMessageFor(m => m.WeightKg, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.HeightCm, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.HeightCm, new { @class = "form-control", type = "number", step = "0.1" })
                        @Html.ValidationMessageFor(m => m.HeightCm, "", new { @class = "text-danger small" })
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-danger py-2">Save Measurement</button>
                        <a href="@Url.Action("Index", "Fitness")" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
