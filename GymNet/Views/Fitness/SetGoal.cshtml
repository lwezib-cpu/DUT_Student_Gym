﻿@model GymNet.ViewModels.SetGoalViewModel
@{
    ViewBag.Title = "Set Fitness Goal";
    ViewBag.Active = "Fitness";
    Layout = "~/Views/Shared/_MemberLayout.cshtml";
}

<h2 class="fw-bold mb-1">Set Your Goal</h2>
<p class="text-muted mb-4">Tell us your target weight and we'll track how close you are.</p>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                @using (Html.BeginForm("SetGoal", "Fitness", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                    <div class="mb-3">
                        @Html.LabelFor(m => m.GoalType, new { @class = "form-label" })
                        @Html.DropDownListFor(m => m.GoalType, new SelectListItem[]
                        {
                            new SelectListItem { Text = "Lose Weight", Value = "LoseWeight" },
                            new SelectListItem { Text = "Gain Weight", Value = "GainWeight" },
                            new SelectListItem { Text = "Maintain Weight", Value = "MaintainWeight" }
                        }, new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.GoalType, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.StartWeightKg, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.StartWeightKg, new { @class = "form-control", type = "number", step = "0.1" })
                        @Html.ValidationMessageFor(m => m.StartWeightKg, "", new { @class = "text-danger small" })
                        <small class="text-muted">Pre-filled from your last logged measurement, if any.</small>
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.TargetWeightKg, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.TargetWeightKg, new { @class = "form-control", type = "number", step = "0.1" })
                        @Html.ValidationMessageFor(m => m.TargetWeightKg, "", new { @class = "text-danger small" })
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-danger py-2">Save Goal</button>
                        <a href="@Url.Action("Index", "Fitness")" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
