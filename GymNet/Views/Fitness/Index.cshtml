﻿@model GymNet.ViewModels.FitnessDashboardViewModel
@{
    ViewBag.Title = "Fitness Goals";
    ViewBag.Active = "Fitness";
    Layout = "~/Views/Shared/_MemberLayout.cshtml";
}

<h2 class="fw-bold mb-1">Fitness Goals</h2>
<p class="text-muted mb-4">Track your weight, height, BMI and progress toward your goal.</p>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card stat-card shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-muted mb-1">Current Weight</h6>
                <h4 class="fw-bold mb-0">
                    @(Model.HasMeasurements ? Model.CurrentWeightKg + " kg" : "-")
                </h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-muted mb-1">Height</h6>
                <h4 class="fw-bold mb-0">
                    @(Model.HasMeasurements ? Model.CurrentHeightCm + " cm" : "-")
                </h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-muted mb-1">BMI</h6>
                <h4 class="fw-bold mb-0">
                    @(Model.HasMeasurements ? Model.CurrentBmi.ToString() : "-")
                </h4>
                @if (Model.HasMeasurements)
                {
                    <span class="badge bg-secondary">@Model.BmiCategory</span>
                }
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-muted mb-1">Last Logged</h6>
                <h4 class="fw-bold mb-0">
                    @(Model.HasMeasurements ? Model.LastRecordedAt.Value.ToString("dd MMM") : "-")
                </h4>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Log measurement / progress after a month -->
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">Progress</h5>
                    <a href="@Url.Action("LogMeasurement", "Fitness")" class="btn btn-sm btn-danger">
                        <i class="bi bi-plus-circle me-1"></i>Log Measurement
                    </a>
                </div>

                @if (!Model.HasMeasurements)
                {
                    <p class="text-muted">No measurements logged yet. Log your weight and height to get started.</p>
                }
                else if (!Model.HasMonthAgoMeasurement)
                {
                    <p class="text-muted">
                        You've logged @Model.CurrentWeightKg kg so far. Come back and log again after about a month
                        to see how you're progressing.
                    </p>
                }
                else
                {
                    var change = Model.WeightChangeKg.Value;
                    var changedText = change == 0 ? "no change" : (Math.Abs(change) + " kg " + (change < 0 ? "lost" : "gained"));
                    var badgeClass = change < 0 ? "bg-success" : (change > 0 ? "bg-warning" : "bg-secondary");
                    <p>
                        A month ago you weighed <strong>@Model.WeightMonthAgoKg kg</strong>.
                        Now you're at <strong>@Model.CurrentWeightKg kg</strong>.
                    </p>
                    <span class="badge @badgeClass fs-6">@changedText over the last month</span>
                }
            </div>
        </div>
    </div>

    <!-- Goal card -->
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">Your Goal</h5>
                    <a href="@Url.Action("SetGoal", "Fitness")" class="btn btn-sm btn-outline-danger">
                        @(Model.HasActiveGoal ? "Update Goal" : "Set a Goal")
                    </a>
                </div>

                @if (!Model.HasActiveGoal)
                {
                    <p class="text-muted">You haven't set a fitness goal yet.</p>
                }
                else
                {
                    var goalLabel = Model.GoalType == "LoseWeight" ? "Lose Weight" :
                                     Model.GoalType == "GainWeight" ? "Gain Weight" : "Maintain Weight";
                    <p class="mb-2">
                        <strong>@goalLabel</strong>:
                        @Model.StartWeightKg kg &rarr; @Model.TargetWeightKg kg
                    </p>
                    <div class="progress mb-2" style="height: 12px;">
                        <div class="progress-bar bg-danger" role="progressbar" style="width: @Model.ProgressPercent%"
                             aria-valuenow="@Model.ProgressPercent" aria-valuemin="0" aria-valuemax="100">
                        </div>
                    </div>
                    <p class="text-muted small mb-0">
                        @Model.ProgressPercent% of the way there &middot; @Model.RemainingKg kg to go
                        &middot; started @Model.GoalStartDate.Value.ToString("dd MMM yyyy")
                    </p>
                }
            </div>
        </div>
    </div>
</div>

@if (Model.MealPlan != null)
{
    <div class="card shadow-sm mt-4">
        <div class="card-header bg-white">
            <h5 class="mb-0 fw-bold"><i class="bi bi-egg-fried me-2 text-danger"></i>Meal Recommendations - @Model.MealPlan.GoalLabel</h5>
            <p class="text-muted small mb-0 mt-1">@Model.MealPlan.Summary</p>
        </div>
        <div class="card-body p-4">
            <div class="row g-4 mb-2">
                @foreach (var meal in Model.MealPlan.Meals)
                {
                    <div class="col-md-6 col-lg-3">
                        <div class="border rounded-3 p-3 h-100 gn-meal-card">
                            <h6 class="fw-bold mb-3">@meal.Emoji @meal.Name</h6>
                            @{ var itemIndex = 0; }
                            @foreach (var item in meal.Items)
                            {
                                itemIndex++;
                                <div class="d-flex align-items-start mb-2 @(itemIndex > 3 ? "gn-meal-extra gn-meal-hidden" : "")">
                                    <span class="me-2" style="font-size: 1.3rem;">@item.Emoji</span>
                                    <div>
                                        <div class="small fw-semibold">@item.Name</div>
                                        <div class="text-muted" style="font-size: 0.78rem;">@item.Note</div>
                                    </div>
                                </div>
                            }
                            @if (meal.Items.Count > 3)
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger w-100 mt-2 gn-meal-viewmore" onclick="gnToggleMeal(this)">
                                    View More
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>

            <hr class="my-4" />

            <h6 class="fw-bold mb-3"><i class="bi bi-basket2 me-2 text-danger"></i>Fruits to Include</h6>
            <div class="row g-3 mb-3">
                @foreach (var fruit in Model.MealPlan.Fruits)
                {
                    <div class="col-md-4">
                        <div class="d-flex align-items-center border rounded-3 p-2">
                            <span class="me-2" style="font-size: 1.5rem;">@fruit.Emoji</span>
                            <div>
                                <div class="small fw-semibold">@fruit.Name</div>
                                <div class="text-muted" style="font-size: 0.78rem;">@fruit.Note</div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="alert alert-secondary small mb-0">
                <i class="bi bi-info-circle me-1"></i>
                These are general examples, not a personalized meal plan. For advice tailored to you, speak with a registered dietitian or your doctor.
            </div>
        </div>
    </div>
}

@if (Model.History.Any())
{
    <div class="card shadow-sm mt-4">
        <div class="card-header bg-white">
            <h5 class="mb-0 fw-bold"><i class="bi bi-clock-history me-2 text-danger"></i>Measurement History</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Weight (kg)</th>
                            <th>Height (cm)</th>
                            <th>BMI</th>
                            <th>Category</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model.History)
                        {
                            <tr>
                                <td>@m.RecordedAt.ToString("dd MMM yyyy")</td>
                                <td>@m.WeightKg</td>
                                <td>@m.HeightCm</td>
                                <td>@m.Bmi</td>
                                <td>@GymNet.Models.BodyMeasurement.BmiCategory(m.Bmi)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<style>
    /* Bootstrap's .d-flex uses display:flex !important, which silently beats a
       plain inline style="display:none" - !important here is required to
       actually win against it. */
    .gn-meal-hidden {
        display: none !important;
    }
</style>

@section scripts {
    <script>
        function gnToggleMeal(btn) {
            var card = btn.closest('.gn-meal-card');
            var extras = card.querySelectorAll('.gn-meal-extra');
            var isHidden = extras.length > 0 && extras[0].classList.contains('gn-meal-hidden');

            extras.forEach(function (el) {
                el.classList.toggle('gn-meal-hidden', !isHidden);
            });

            btn.textContent = isHidden ? btn.getAttribute('data-more-label') : 'View Less';
        }

        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.gn-meal-viewmore').forEach(function (btn) {
                btn.setAttribute('data-more-label', btn.textContent.trim());
            });
        });
    </script>
}
