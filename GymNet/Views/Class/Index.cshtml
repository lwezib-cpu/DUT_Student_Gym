﻿@model List<GymNet.ViewModels.ClassListItemViewModel>
@{
    ViewBag.Title = "Classes";
    ViewBag.Active = "Classes";
    Layout = "~/Views/Shared/_MemberLayout.cshtml";
}

<h2 class="fw-bold mb-1">Classes</h2>
<p class="text-muted mb-4">Join an upcoming class led by one of our trainers.</p>

@if (!Model.Any())
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <p class="text-muted mb-0">No upcoming classes right now. Check back soon.</p>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var c in Model)
        {
            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="fw-bold mb-0">@c.Title</h5>
                            @if (c.IsFull && !c.IsBookedByCurrentUser && !c.IsWaitlistedByCurrentUser)
                            {
                                <span class="badge bg-danger">Full</span>
                            }
                        </div>
                        <div class="d-flex align-items-center mb-2">
                            @if (!string.IsNullOrEmpty(c.TrainerPhotoUrl))
                            {
                                <img src="@Url.Content(c.TrainerPhotoUrl)" alt="@c.TrainerName" class="rounded-circle me-2" style="width: 36px; height: 36px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-secondary bg-opacity-10 me-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                    <i class="bi bi-person-fill text-secondary small"></i>
                                </div>
                            }
                            <div>
                                <p class="text-muted small mb-0">with @c.TrainerName</p>
                                @if (!string.IsNullOrEmpty(c.TrainerSpecialty))
                                {
                                    <span class="badge bg-danger" style="font-size: 0.65rem;">@c.TrainerSpecialty</span>
                                }
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(c.Description))
                        {
                            <p class="mb-2">@c.Description</p>
                        }
                        <p class="text-muted small mb-3">
                            <i class="bi bi-calendar-event me-1"></i>@c.StartTime.ToString("dd MMM yyyy, HH:mm")
                            &middot; @c.DurationMinutes min &middot; @c.BookedCount / @c.Capacity booked
                            @if (c.WaitlistCount > 0)
                            {
                                <text>&middot; @c.WaitlistCount on waitlist</text>
                            }
                        </p>

                        @if (c.IsBookedByCurrentUser)
                        {
                            <div class="alert alert-success py-2 mb-2"><i class="bi bi-check-circle me-1"></i>You're booked in</div>
                            using (Html.BeginForm("Leave", "Class", new { id = c.Id }, FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger w-100">Leave Class</button>
                            }
                        }
                        else if (c.IsWaitlistedByCurrentUser)
                        {
                            <div class="alert alert-warning py-2 mb-2"><i class="bi bi-hourglass-split me-1"></i>You're on the waitlist</div>
                            using (Html.BeginForm("Leave", "Class", new { id = c.Id }, FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger w-100">Leave Waitlist</button>
                            }
                        }
                        else if (c.IsFull)
                        {
                            using (Html.BeginForm("Join", "Class", new { id = c.Id }, FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-warning w-100">Join Waitlist</button>
                            }
                        }
                        else
                        {
                            using (Html.BeginForm("Join", "Class", new { id = c.Id }, FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger w-100">Join Class</button>
                            }
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
